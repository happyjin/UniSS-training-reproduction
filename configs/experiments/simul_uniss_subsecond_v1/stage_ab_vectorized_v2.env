# Isolated continuation of the Stage-B pilot after the vectorized Emformer
# input-packing optimization. Stage A and the historical v1 run are read-only.

REPO_ROOT="${REPO_ROOT:-/opt/dlami/nvme/jasonleeeli/projects/UniSS}"
# shellcheck source=/dev/null
source "${REPO_ROOT}/configs/experiments/simul_uniss_subsecond_v1/stage_ab.env"

STAGE_A_ROOT="${REPO_ROOT}/data/processed/simul_uniss_subsecond_v1/pilot_15shard/stage_a_source"
STAGE_B_ROOT="${REPO_ROOT}/checkpoints/simul_uniss_subsecond_v1/stage_b_pilot_15shard_vectorized_v2"
STAGE_B_RUN_ROOT="${REPO_ROOT}/runs/simul_uniss_subsecond_v1/stage_b_pilot_15shard_vectorized_v2"
LOG_ROOT="${REPO_ROOT}/logs/simul_uniss_subsecond_v1/stage_b_pilot_15shard_vectorized_v2"
TENSORBOARD_PORT="6051"

# The measured throughput optimum preserves the v1 optimization semantics.
STAGE_B_BATCH_SIZE="64"
STAGE_B_MAX_AUDIO_SECONDS="8"
STAGE_B_NUM_WORKERS="8"
STAGE_B_HIDDEN_SIZE="768"
STAGE_B_NUM_LAYERS="16"
STAGE_B_NUM_HEADS="12"
STAGE_B_FFN_DIM="3072"
STAGE_B_MASTER_PORT="29687"
