# Isolated Stage-A/Stage-B true-streaming pilot. Historical experiments are read-only.

USER_ROOT="${USER_ROOT:-/opt/dlami/nvme/jasonleeeli}"
REPO_ROOT="${REPO_ROOT:-${USER_ROOT}/projects/UniSS}"
ACTIVATE_SCRIPT="${ACTIVATE_SCRIPT:-${USER_ROOT}/env_recovery/uniss-train-20260721/activate_uniss.sh}"

UNIST_ROOT="${UNIST_ROOT:-${REPO_ROOT}/data/raw/UniST}"
BICODEC_CHECKPOINT="${BICODEC_CHECKPOINT:-${REPO_ROOT}/pretrained_models/UniSS/bicodec/BiCodec}"
POLICY_TOKENIZER_MODEL="${POLICY_TOKENIZER_MODEL:-${REPO_ROOT}/data/processed/simul_uniss_v1/bootstrap_15shard/policy_tokenizer/policy_8k.model}"

SUBSECOND_EXPERIMENT="${SUBSECOND_EXPERIMENT:-simul_uniss_subsecond_v1}"
SHARD_START="${SHARD_START:-0}"
SHARD_COUNT="${SHARD_COUNT:-15}"

STAGE_A_ROOT="${STAGE_A_ROOT:-${REPO_ROOT}/data/processed/${SUBSECOND_EXPERIMENT}/pilot_15shard/stage_a_source}"
STAGE_A_PARTS_ROOT="${STAGE_A_PARTS_ROOT:-${STAGE_A_ROOT}/parts}"
STAGE_A_SMOKE_ROOT="${STAGE_A_SMOKE_ROOT:-${REPO_ROOT}/data/processed/${SUBSECOND_EXPERIMENT}/smoke/stage_a_source}"
STAGE_A_RECORDS_PER_SHARD="${STAGE_A_RECORDS_PER_SHARD:-100000}"
STAGE_A_SMOKE_RECORDS_PER_SHARD="${STAGE_A_SMOKE_RECORDS_PER_SHARD:-4}"
STAGE_A_SIDE="${STAGE_A_SIDE:-source}"

STAGE_B_ROOT="${STAGE_B_ROOT:-${REPO_ROOT}/checkpoints/${SUBSECOND_EXPERIMENT}/stage_b_pilot_15shard}"
STAGE_B_SMOKE_ROOT="${STAGE_B_SMOKE_ROOT:-${REPO_ROOT}/checkpoints/${SUBSECOND_EXPERIMENT}/stage_b_smoke}"
STAGE_B_RUN_ROOT="${STAGE_B_RUN_ROOT:-${REPO_ROOT}/runs/${SUBSECOND_EXPERIMENT}/stage_b_pilot_15shard}"
STAGE_B_SMOKE_RUN_ROOT="${STAGE_B_SMOKE_RUN_ROOT:-${REPO_ROOT}/runs/${SUBSECOND_EXPERIMENT}/stage_b_smoke}"

LOG_ROOT="${LOG_ROOT:-${REPO_ROOT}/logs/${SUBSECOND_EXPERIMENT}}"
TENSORBOARD_PORT="${TENSORBOARD_PORT:-6050}"
CUDA_DEVICES="${CUDA_DEVICES:-0,1,2,3,4,5,6,7}"
