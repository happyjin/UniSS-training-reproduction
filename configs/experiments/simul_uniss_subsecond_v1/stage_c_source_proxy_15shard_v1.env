# Isolated Stage-C source safe-commit Bayesian pilot.  This freezes Stage B
# and uses the existing 15-shard source manifest plus independent UniST dev.

USER_ROOT="${USER_ROOT:-/opt/dlami/nvme/jasonleeeli}"
REPO_ROOT="${REPO_ROOT:-${USER_ROOT}/projects/UniSS}"
ACTIVATE_SCRIPT="${ACTIVATE_SCRIPT:-${USER_ROOT}/env_recovery/uniss-train-20260721/activate_uniss.sh}"

STAGE_C_TRAIN_MANIFEST="${REPO_ROOT}/data/processed/simul_uniss_subsecond_v1/pilot_15shard/stage_a_source/stage_a_source_manifest.jsonl"
STAGE_C_VALID_MANIFEST="${REPO_ROOT}/data/processed/simul_uniss_subsecond_e2_v1/unist_dev/stage_a_source/manifest.jsonl"
STAGE_C_STUDENT_CHECKPOINT="${REPO_ROOT}/checkpoints/simul_uniss_subsecond_v1/stage_b_pilot_15shard_vectorized_v2/best.pt"
STAGE_C_OUTPUT_DIR="${REPO_ROOT}/checkpoints/simul_uniss_subsecond_v1/stage_c_source_proxy_15shard_v1"
STAGE_C_TENSORBOARD_DIR="${REPO_ROOT}/runs/simul_uniss_subsecond_v1/stage_c_source_proxy_15shard_v1/tensorboard"
STAGE_C_LOG_DIR="${REPO_ROOT}/logs/simul_uniss_subsecond_v1/stage_c_source_proxy_15shard_v1"

STAGE_C_BATCH_SIZE="${STAGE_C_BATCH_SIZE:-128}"
STAGE_C_MAX_STEPS="${STAGE_C_MAX_STEPS:-10000}"
STAGE_C_LEARNING_RATE="${STAGE_C_LEARNING_RATE:-3e-4}"
STAGE_C_NUM_WORKERS="${STAGE_C_NUM_WORKERS:-8}"
STAGE_C_MASTER_PORT="${STAGE_C_MASTER_PORT:-29720}"
STAGE_C_TENSORBOARD_PORT="${STAGE_C_TENSORBOARD_PORT:-6052}"
CUDA_DEVICES="${CUDA_DEVICES:-0,1,2,3,4,5,6,7}"
