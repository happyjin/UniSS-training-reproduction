# Stage-D Micro-WRITE proxy pilot.  It intentionally uses the existing
# proportional 15-shard schedules and is not formal bilingual-aligned Stage D.

source "/opt/dlami/nvme/jasonleeeli/projects/UniSS/configs/experiments/simul_uniss_v1/bootstrap_15shard.env"

STAGE_D_ROOT="${REPO_ROOT}/data/processed/simul_uniss_subsecond_v1/stage_d_micro_write_proxy_15shard_v1"
STAGE_D_TRAIN_ROOT="${STAGE_D_ROOT}/train"
STAGE_D_VALID_ROOT="${STAGE_D_ROOT}/valid"
[[ ! -f "${STAGE_D_TRAIN_ROOT}/training_schedule.env" ]] || source "${STAGE_D_TRAIN_ROOT}/training_schedule.env"

PACKED_TRAIN="${STAGE_D_TRAIN_ROOT}/packed.jsonl"
VALID_PACKED_INTERLEAVED="${STAGE_D_VALID_ROOT}/packed.jsonl"
SEQ_LENGTH="18000"

STAGE4_LOAD_ROOT="${REPO_ROOT}/checkpoints/uniss_qwen0p5b_phase3_unist198_after_phase2_v4"
STAGE4_SAVE_ROOT="${STAGE_D_SAVE_ROOT:-${REPO_ROOT}/checkpoints/simul_uniss_subsecond_v1/stage_d_micro_write_proxy_15shard_v1}"
STAGE4_TENSORBOARD_DIR="${STAGE_D_TENSORBOARD_DIR:-${REPO_ROOT}/runs/simul_uniss_subsecond_v1/stage_d_micro_write_proxy_15shard_v1/tensorboard}"
STAGE4_MASTER_PORT="${STAGE_D_MASTER_PORT:-29730}"
STAGE4_TRAIN_ITERS="${STAGE_D_TRAIN_ITERS:-1000}"
STAGE4_QWEN_WARMUP_ITERS="${STAGE_D_WARMUP_ITERS:-50}"

SIMUL_CUDA_VISIBLE_DEVICES="0,1,2,3,4,5,6,7"
SIMUL_NPROC_PER_NODE="8"
SIMUL_MICRO_BATCH_SIZE="2"
SIMUL_GLOBAL_BATCH_SIZE="128"
SIMUL_DATALOADER_TYPE="cyclic"
SIMUL_DATA_SEED="20260731"
SIMUL_QWEN_LR="5e-6"
SIMUL_QWEN_MIN_LR="5e-7"
SIMUL_QWEN_SAVE_INTERVAL="100"
SIMUL_QWEN_EVAL_INTERVAL="100"
SIMUL_QWEN_EVAL_ITERS="5"
SIMUL_NO_DATA_SHARDING="1"
SIMUL_FULL_VALIDATION="1"
SIMUL_OFFSET_INDEX_MODE="sidecar"
SIMUL_NO_LOAD_OPTIM="1"
SIMUL_NO_LOAD_RNG="1"
SIMUL_FINETUNE="1"

LOG_DIR="${REPO_ROOT}/logs/simul_uniss_subsecond_v1/stage_d_micro_write_proxy_15shard_v1"
STAGE_D_TENSORBOARD_PORT="${STAGE_D_TENSORBOARD_PORT:-6053}"
