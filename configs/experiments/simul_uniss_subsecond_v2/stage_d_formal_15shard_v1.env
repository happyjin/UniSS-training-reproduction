# Formal target-aligned Micro-WRITE Stage D with immutable Phase3 replay.

USER_ROOT="${USER_ROOT:-/opt/dlami/nvme/jasonleeeli}"
REPO_ROOT="${REPO_ROOT:-${USER_ROOT}/projects/UniSS}"
ACTIVATE_SCRIPT="${ACTIVATE_SCRIPT:-${USER_ROOT}/env_recovery/uniss-train-20260721/activate_uniss.sh}"
# shellcheck source=/dev/null
source "${REPO_ROOT}/configs/experiments/simul_uniss_v1/bootstrap_15shard.env"

FORMAL_STAGE_A_ROOT="${REPO_ROOT}/data/processed/simul_uniss_subsecond_v2/formal_15shard_v1/stage_a_formal"
STAGE_D_DATA_ROOT="${REPO_ROOT}/data/processed/simul_uniss_subsecond_v2/stage_d_formal_15shard_v1"
STAGE_D_TRAIN_ROOT="${STAGE_D_DATA_ROOT}/train"
STAGE_D_VALID_ROOT="${STAGE_D_DATA_ROOT}/valid"
[[ ! -f "${STAGE_D_TRAIN_ROOT}/training_schedule.env" ]] || source "${STAGE_D_TRAIN_ROOT}/training_schedule.env"

PACKED_TRAIN="${PACKED_TRAIN:-${STAGE_D_TRAIN_ROOT}/packed.jsonl}"
VALID_PACKED_INTERLEAVED="${VALID_PACKED_INTERLEAVED:-${STAGE_D_VALID_ROOT}/packed.jsonl}"
SEQ_LENGTH="18000"

STAGE4_LOAD_ROOT="${REPO_ROOT}/checkpoints/uniss_qwen0p5b_phase3_unist198_after_phase2_v4"
STAGE4_SAVE_ROOT="${STAGE_D_SAVE_ROOT:-${REPO_ROOT}/checkpoints/simul_uniss_subsecond_v2/stage_d_formal_15shard_v1}"
STAGE4_TENSORBOARD_DIR="${STAGE_D_TENSORBOARD_DIR:-${REPO_ROOT}/runs/simul_uniss_subsecond_v2/stage_d_formal_15shard_v1/tensorboard}"
STAGE4_MASTER_PORT="${STAGE_D_MASTER_PORT:-29742}"
STAGE4_TRAIN_ITERS="${STAGE_D_TRAIN_ITERS:-1000}"
STAGE4_QWEN_WARMUP_ITERS="${STAGE_D_WARMUP_ITERS:-50}"

# The bootstrap config intentionally provides historical 4k/1/32 defaults.
# Assign formal Stage-D values explicitly so sourcing bootstrap cannot silently
# lower H200 utilization. STAGE_D_* names remain available as clean overrides.
SIMUL_CUDA_VISIBLE_DEVICES="${STAGE_D_CUDA_VISIBLE_DEVICES:-0,1,2,3,4,5,6,7}"
SIMUL_NPROC_PER_NODE="${STAGE_D_NPROC_PER_NODE:-8}"
SIMUL_MICRO_BATCH_SIZE="${STAGE_D_MICRO_BATCH_SIZE:-2}"
SIMUL_GLOBAL_BATCH_SIZE="${STAGE_D_GLOBAL_BATCH_SIZE:-128}"
SIMUL_DATALOADER_TYPE="${STAGE_D_DATALOADER_TYPE:-cyclic}"
SIMUL_DATA_SEED="${STAGE_D_DATA_SEED:-20260731}"
SIMUL_QWEN_LR="${STAGE_D_QWEN_LR:-5e-6}"
SIMUL_QWEN_MIN_LR="${STAGE_D_QWEN_MIN_LR:-5e-7}"
SIMUL_QWEN_SAVE_INTERVAL="${STAGE_D_QWEN_SAVE_INTERVAL:-100}"
SIMUL_QWEN_EVAL_INTERVAL="${STAGE_D_QWEN_EVAL_INTERVAL:-100}"
SIMUL_QWEN_EVAL_ITERS="${STAGE_D_QWEN_EVAL_ITERS:-5}"
SIMUL_QWEN_LOG_INTERVAL="${STAGE_D_QWEN_LOG_INTERVAL:-1}"
SIMUL_QWEN_TENSORBOARD_LOG_INTERVAL="${STAGE_D_TENSORBOARD_LOG_INTERVAL:-1}"
SIMUL_QWEN_TENSORBOARD_MEMORY_INTERVAL="${STAGE_D_TENSORBOARD_MEMORY_INTERVAL:-1}"
SIMUL_NO_DATA_SHARDING="${STAGE_D_NO_DATA_SHARDING:-1}"
SIMUL_FULL_VALIDATION="${STAGE_D_FULL_VALIDATION:-1}"
SIMUL_OFFSET_INDEX_MODE="${STAGE_D_OFFSET_INDEX_MODE:-sidecar}"
SIMUL_NO_LOAD_OPTIM="${STAGE_D_NO_LOAD_OPTIM:-1}"
SIMUL_NO_LOAD_RNG="${STAGE_D_NO_LOAD_RNG:-1}"
SIMUL_FINETUNE="${STAGE_D_FINETUNE:-1}"

LOG_DIR="${REPO_ROOT}/logs/simul_uniss_subsecond_v2/stage_d_formal_15shard_v1"
STAGE_D_TENSORBOARD_PORT="${STAGE_D_TENSORBOARD_PORT:-6056}"
