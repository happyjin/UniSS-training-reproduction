# Formal A4--A8 15-shard pipeline. Historical subsecond_v1 outputs are read-only.

REPO_ROOT="${REPO_ROOT:-/opt/dlami/nvme/jasonleeeli/projects/UniSS}"
USER_ROOT="${USER_ROOT:-/opt/dlami/nvme/jasonleeeli}"
TRAIN_PYTHON="${TRAIN_PYTHON:-${USER_ROOT}/conda_envs/uniss-train/bin/python3}"
ALIGN_PYTHON="${ALIGN_PYTHON:-${USER_ROOT}/venvs/uniss-formal-align-v1/bin/python}"
HF_HOME="${HF_HOME:-${USER_ROOT}/cache/huggingface}"

V1_STAGE_A_PARTS="${REPO_ROOT}/data/processed/simul_uniss_subsecond_v1/pilot_15shard/stage_a_source/parts"
FORMAL_ROOT="${REPO_ROOT}/data/processed/simul_uniss_subsecond_v2/formal_15shard_v1"
A45_ROOT="${FORMAL_ROOT}/a45_parts"
A68_ROOT="${FORMAL_ROOT}/a68_parts"
FORMAL_STAGE_A_ROOT="${FORMAL_ROOT}/stage_a_formal"
LOG_ROOT="${REPO_ROOT}/logs/simul_uniss_subsecond_v2/formal_15shard_v1"

FORCED_ALIGNER_MODEL="${USER_ROOT}/projects/multi_speaker_pipeline_share/multi_speaker_pipeline_share/model_weights/Qwen3-ForcedAligner-0.6B"
WHISPERVQ_MODEL="${REPO_ROOT}/pretrained_models/UniSS/glm4_tokenizer"
BICODEC_CHECKPOINT="${REPO_ROOT}/pretrained_models/UniSS/bicodec/BiCodec"
WORD_ALIGNER_MODEL="bert-base-multilingual-cased"

SHARD_COUNT="15"
CHUNKS_PER_SHARD="2"
RECORDS_PER_CHUNK="50000"
GPU_COUNT="8"
LANES_PER_GPU="2"
A45_WORKER_BATCH_SIZE="256"
A45_ALIGNMENT_BATCH_SIZE="256"
A68_BATCH_SIZE="128"
A45_MINIMUM_COVERAGE="0.85"
A68_MINIMUM_LINK_COVERAGE="0.45"

STAGE_B_ROOT="${REPO_ROOT}/checkpoints/simul_uniss_subsecond_v2/stage_b_formal_15shard_v1"
STAGE_B_RUN_ROOT="${REPO_ROOT}/runs/simul_uniss_subsecond_v2/stage_b_formal_15shard_v1"
STAGE_C_ROOT="${REPO_ROOT}/checkpoints/simul_uniss_subsecond_v2/stage_c_formal_15shard_v1"
STAGE_C_RUN_ROOT="${REPO_ROOT}/runs/simul_uniss_subsecond_v2/stage_c_formal_15shard_v1"
STAGE_D_ROOT="${REPO_ROOT}/checkpoints/simul_uniss_subsecond_v2/stage_d_formal_15shard_v1"
STAGE_D_RUN_ROOT="${REPO_ROOT}/runs/simul_uniss_subsecond_v2/stage_d_formal_15shard_v1"

