# Formal Stage-B causal Student on reconstructed-audio WhisperVQ supervision.
# Historical v1/proxy experiments are read-only and keep their original fields.

USER_ROOT="${USER_ROOT:-/opt/dlami/nvme/jasonleeeli}"
REPO_ROOT="${REPO_ROOT:-${USER_ROOT}/projects/UniSS}"
ACTIVATE_SCRIPT="${ACTIVATE_SCRIPT:-${USER_ROOT}/env_recovery/uniss-train-20260721/activate_uniss.sh}"

FORMAL_STAGE_A_ROOT="${REPO_ROOT}/data/processed/simul_uniss_subsecond_v2/formal_15shard_v1/stage_a_formal"
FORMAL_STAGE_A_BENCHMARK="${REPO_ROOT}/data/processed/simul_uniss_subsecond_v2/benchmark/formal_stage_a_128_final"
POLICY_TOKENIZER_MODEL="${REPO_ROOT}/data/processed/simul_uniss_v1/bootstrap_15shard/policy_tokenizer/policy_8k.model"

STAGE_B_TRAIN_MANIFEST="${FORMAL_STAGE_A_ROOT}/a45_manifest.jsonl"
STAGE_B_VALID_MANIFEST="${FORMAL_STAGE_A_ROOT}/formal_valid_manifest.jsonl"
STAGE_B_SMOKE_MANIFEST="${FORMAL_STAGE_A_BENCHMARK}/a45_manifest.jsonl"
STAGE_B_SMOKE_VALID_MANIFEST="${FORMAL_STAGE_A_BENCHMARK}/formal_valid_manifest.jsonl"
STAGE_B_TEACHER_FIELD="teacher_source_glm"
STAGE_B_TEACHER_END_FIELD="teacher_source_glm_end_ms"
STAGE_B_COMPATIBILITY_FIELD="released_source_glm"

STAGE_B_ROOT="${REPO_ROOT}/checkpoints/simul_uniss_subsecond_v2/stage_b_formal_15shard_v1"
STAGE_B_RUN_ROOT="${REPO_ROOT}/runs/simul_uniss_subsecond_v2/stage_b_formal_15shard_v1"
STAGE_B_LOG_ROOT="${REPO_ROOT}/logs/simul_uniss_subsecond_v2/stage_b_formal_15shard_v1"
STAGE_B_SMOKE_ROOT="${REPO_ROOT}/checkpoints/simul_uniss_subsecond_v2/smoke/stage_b_formal_launcher"
STAGE_B_SMOKE_RUN_ROOT="${REPO_ROOT}/runs/simul_uniss_subsecond_v2/smoke/stage_b_formal_launcher"

# H200 throughput scan from the isolated v1 run: 64 examples per rank was the
# best tested point without approaching OOM. Global effective batch is 512.
STAGE_B_BATCH_SIZE="${STAGE_B_BATCH_SIZE:-64}"
STAGE_B_MAX_STEPS="${STAGE_B_MAX_STEPS:-50000}"
STAGE_B_LEARNING_RATE="${STAGE_B_LEARNING_RATE:-1e-4}"
STAGE_B_HIDDEN_SIZE="${STAGE_B_HIDDEN_SIZE:-768}"
STAGE_B_NUM_LAYERS="${STAGE_B_NUM_LAYERS:-16}"
STAGE_B_NUM_HEADS="${STAGE_B_NUM_HEADS:-12}"
STAGE_B_FFN_DIM="${STAGE_B_FFN_DIM:-3072}"
STAGE_B_MAX_AUDIO_SECONDS="${STAGE_B_MAX_AUDIO_SECONDS:-8}"
STAGE_B_NUM_WORKERS="${STAGE_B_NUM_WORKERS:-8}"
STAGE_B_VALIDATION_RECORDS="${STAGE_B_VALIDATION_RECORDS:-256}"
STAGE_B_VALIDATION_SAMPLES="${STAGE_B_VALIDATION_SAMPLES:-512}"
STAGE_B_MINIMUM_AGREEMENT="${STAGE_B_MINIMUM_AGREEMENT:-0.90}"
STAGE_B_MAXIMUM_RTF="${STAGE_B_MAXIMUM_RTF:-0.25}"
STAGE_B_MASTER_PORT="${STAGE_B_MASTER_PORT:-29740}"
STAGE_B_TENSORBOARD_PORT="${STAGE_B_TENSORBOARD_PORT:-6054}"
CUDA_DEVICES="${CUDA_DEVICES:-0,1,2,3,4,5,6,7}"

