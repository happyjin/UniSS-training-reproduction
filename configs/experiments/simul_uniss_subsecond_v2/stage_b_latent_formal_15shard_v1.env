# Corrected Stage-B: fixed-rate latent regression into the frozen WhisperVQ codebook.
# Historical CTC Stage-B paths remain read-only and unchanged.

USER_ROOT="${USER_ROOT:-/opt/dlami/nvme/jasonleeeli}"
REPO_ROOT="${REPO_ROOT:-${USER_ROOT}/projects/UniSS}"
ACTIVATE_SCRIPT="${ACTIVATE_SCRIPT:-${USER_ROOT}/env_recovery/uniss-train-20260721/activate_uniss.sh}"

FORMAL_STAGE_A_ROOT="${REPO_ROOT}/data/processed/simul_uniss_subsecond_v2/formal_15shard_v1/stage_a_formal"
FORMAL_STAGE_A_BENCHMARK="${REPO_ROOT}/data/processed/simul_uniss_subsecond_v2/benchmark/formal_stage_a_128_final"
STAGE_A_COMPLETE_MARKER="${FORMAL_STAGE_A_ROOT}/STAGE_A_COMPLETE.json"

STAGE_B_LATENT_TRAIN_MANIFEST="${FORMAL_STAGE_A_ROOT}/formal_train_manifest.jsonl"
STAGE_B_LATENT_VALID_MANIFEST="${FORMAL_STAGE_A_ROOT}/formal_valid_manifest.jsonl"
STAGE_B_LATENT_SMOKE_MANIFEST="${FORMAL_STAGE_A_BENCHMARK}/formal_train_manifest.jsonl"
STAGE_B_LATENT_SMOKE_VALID_MANIFEST="${FORMAL_STAGE_A_BENCHMARK}/formal_valid_manifest.jsonl"
STAGE_B_LATENT_TEACHER_FIELD="teacher_source_glm"
STAGE_B_LATENT_TEACHER_END_FIELD="teacher_source_glm_end_ms"

POLICY_TOKENIZER_MODEL="${REPO_ROOT}/data/processed/simul_uniss_v1/bootstrap_15shard/policy_tokenizer/policy_8k.model"
WHISPERVQ_CODEBOOK_MODEL="${REPO_ROOT}/pretrained_models/UniSS/glm4_tokenizer"
WHISPERVQ_CODEBOOK_KEY="codebook.weight"

STAGE_B_LATENT_ROOT="${REPO_ROOT}/checkpoints/simul_uniss_subsecond_v2/stage_b_latent_formal_15shard_v1"
STAGE_B_LATENT_RUN_ROOT="${REPO_ROOT}/runs/simul_uniss_subsecond_v2/stage_b_latent_formal_15shard_v1"
STAGE_B_LATENT_LOG_ROOT="${REPO_ROOT}/logs/simul_uniss_subsecond_v2/stage_b_latent_formal_15shard_v1"
STAGE_B_LATENT_SMOKE_ROOT="${REPO_ROOT}/checkpoints/simul_uniss_subsecond_v2/smoke/stage_b_latent_formal_launcher"
STAGE_B_LATENT_SMOKE_RUN_ROOT="${REPO_ROOT}/runs/simul_uniss_subsecond_v2/smoke/stage_b_latent_formal_launcher"

# H200 scan on the corrected full-size model:
#   64/rank  -> ~40 GiB peak
#   128/rank -> ~78 GiB peak, 92--100% SM utility, 490--549 W
#   192/rank -> ~136 GiB reserved, unsafe for a long run
# Use the highest sustained-throughput point with ample OOM headroom.
STAGE_B_LATENT_BATCH_SIZE="${STAGE_B_LATENT_BATCH_SIZE:-128}"
STAGE_B_LATENT_MAX_STEPS="${STAGE_B_LATENT_MAX_STEPS:-50000}"
STAGE_B_LATENT_LEARNING_RATE="${STAGE_B_LATENT_LEARNING_RATE:-1e-4}"
STAGE_B_LATENT_HIDDEN_SIZE="${STAGE_B_LATENT_HIDDEN_SIZE:-768}"
STAGE_B_LATENT_NUM_LAYERS="${STAGE_B_LATENT_NUM_LAYERS:-16}"
STAGE_B_LATENT_NUM_HEADS="${STAGE_B_LATENT_NUM_HEADS:-12}"
STAGE_B_LATENT_FFN_DIM="${STAGE_B_LATENT_FFN_DIM:-3072}"
STAGE_B_LATENT_MAX_AUDIO_SECONDS="${STAGE_B_LATENT_MAX_AUDIO_SECONDS:-8}"
STAGE_B_LATENT_NUM_WORKERS="${STAGE_B_LATENT_NUM_WORKERS:-8}"
STAGE_B_LATENT_CPU_THREADS="${STAGE_B_LATENT_CPU_THREADS:-4}"
STAGE_B_LATENT_EVAL_BATCHES="${STAGE_B_LATENT_EVAL_BATCHES:-16}"
STAGE_B_LATENT_VALIDATION_SAMPLES="${STAGE_B_LATENT_VALIDATION_SAMPLES:-128}"
STAGE_B_LATENT_LATENCY_SAMPLES="${STAGE_B_LATENT_LATENCY_SAMPLES:-16}"

STAGE_B_LATENT_WEIGHT="${STAGE_B_LATENT_WEIGHT:-1.0}"
STAGE_B_HIDDEN_DISTILL_WEIGHT="${STAGE_B_HIDDEN_DISTILL_WEIGHT:-0.5}"
STAGE_B_SOURCE_WEIGHT="${STAGE_B_SOURCE_WEIGHT:-0.3}"
STAGE_B_CAPACITY_WEIGHT="${STAGE_B_CAPACITY_WEIGHT:-0.4}"
STAGE_B_STABILITY_WEIGHT="${STAGE_B_STABILITY_WEIGHT:-0.2}"
STAGE_B_CONSISTENCY_WEIGHT="${STAGE_B_CONSISTENCY_WEIGHT:-0.1}"
STAGE_B_CONSISTENCY_INTERVAL="${STAGE_B_CONSISTENCY_INTERVAL:-4}"

# 0.70 is the research continuation gate; 0.90 remains the final goal.
STAGE_B_LATENT_MINIMUM_AGREEMENT="${STAGE_B_LATENT_MINIMUM_AGREEMENT:-0.70}"
STAGE_B_LATENT_GOAL_AGREEMENT="${STAGE_B_LATENT_GOAL_AGREEMENT:-0.90}"
STAGE_B_LATENT_MAXIMUM_RTF="${STAGE_B_LATENT_MAXIMUM_RTF:-0.25}"
STAGE_B_LATENT_MAXIMUM_FIRST_P50_MS="${STAGE_B_LATENT_MAXIMUM_FIRST_P50_MS:-700}"
STAGE_B_LATENT_MAXIMUM_FIRST_P95_MS="${STAGE_B_LATENT_MAXIMUM_FIRST_P95_MS:-1000}"
STAGE_B_LATENT_MINIMUM_CHUNK_INVARIANCE="${STAGE_B_LATENT_MINIMUM_CHUNK_INVARIANCE:-0.95}"
STAGE_B_LATENT_MINIMUM_CORRECT_STABLE_COVERAGE="${STAGE_B_LATENT_MINIMUM_CORRECT_STABLE_COVERAGE:-0.90}"

STAGE_B_LATENT_MASTER_PORT="${STAGE_B_LATENT_MASTER_PORT:-29743}"
STAGE_B_LATENT_TENSORBOARD_PORT="${STAGE_B_LATENT_TENSORBOARD_PORT:-6057}"
CUDA_DEVICES="${CUDA_DEVICES:-0,1,2,3,4,5,6,7}"
