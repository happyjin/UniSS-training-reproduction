# Isolated 8-GPU Qwen2.5-3B UniST-198 Phase1 full run.
# TP=2 is required. TP=1 OOMs on vocab CE.

USER_ROOT="${USER_ROOT:-/opt/dlami/nvme/neuhao}"
ACTIVATE_SCRIPT="${ACTIVATE_SCRIPT:-${USER_ROOT}/env_recovery/uniss-train-20260721/activate_uniss.sh}"
ENV_ROOT="${ENV_ROOT:-${USER_ROOT}/conda_envs/uniss-train}"

EXPERIMENT_NAME="${EXPERIMENT_NAME:-uniss_qwen3b_phase1_unist198_full_v1}"

TRAIN_DATA="${TRAIN_DATA:-${REPO_ROOT}/data/megatron/phase1_unist198/packed_train.jsonl}"
VALID_DATA="${VALID_DATA:-${REPO_ROOT}/data/megatron/validation_unist_dev/phase1_valid_packed.jsonl}"
LOAD_CHECKPOINT="${LOAD_CHECKPOINT:-${REPO_ROOT}/checkpoints/qwen2_3b_uniss_vocab}"
SAVE_DIR="${SAVE_DIR:-${REPO_ROOT}/checkpoints/${EXPERIMENT_NAME}}"

RUN_DIR="${RUN_DIR:-${REPO_ROOT}/runs/${EXPERIMENT_NAME}}"
TENSORBOARD_DIR="${TENSORBOARD_DIR:-${RUN_DIR}/tensorboard}"
LOG_PATH="${LOG_PATH:-${REPO_ROOT}/logs/${EXPERIMENT_NAME}.log}"
GPU_LOG="${GPU_LOG:-${REPO_ROOT}/logs/${EXPERIMENT_NAME}_gpu_power_utility.csv}"

CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0,1,2,3,4,5,6,7}"
NPROC_PER_NODE="${NPROC_PER_NODE:-8}"
TP="${TP:-2}"
PP="${PP:-1}"
MICRO_BATCH_SIZE="${MICRO_BATCH_SIZE:-1}"
GLOBAL_BATCH_SIZE="${GLOBAL_BATCH_SIZE:-128}"

TRAIN_ITERS="${TRAIN_ITERS:-18765}"
LR="${LR:-8e-4}"
MIN_LR="${MIN_LR:-8e-4}"
LR_WARMUP_ITERS="${LR_WARMUP_ITERS:-6255}"
LR_DECAY_STYLE="${LR_DECAY_STYLE:-constant}"

SAVE_INTERVAL="${SAVE_INTERVAL:-100}"
# Megatron still drops non-multiples of 500 between saves. A sidecar then
# uploads every 500-step ckpt to S3 and keeps only LOCAL_KEEP newest dirs.
SAVE_RETAIN_INTERVAL="${SAVE_RETAIN_INTERVAL:-500}"
BACKUP_EVERY="${BACKUP_EVERY:-500}"
LOCAL_KEEP="${LOCAL_KEEP:-3}"
# Must be exported by the caller, e.g. s3://<bucket>/<prefix>/checkpoints/${EXPERIMENT_NAME}.
S3_CHECKPOINT_PREFIX="${S3_CHECKPOINT_PREFIX:-}"
EVAL_INTERVAL="${EVAL_INTERVAL:-100}"
EVAL_ITERS="${EVAL_ITERS:-10}"
LOG_INTERVAL="${LOG_INTERVAL:-10}"
TENSORBOARD_LOG_INTERVAL="${TENSORBOARD_LOG_INTERVAL:-10}"
TENSORBOARD_MEMORY_INTERVAL="${TENSORBOARD_MEMORY_INTERVAL:-10}"
MASTER_PORT="${MASTER_PORT:-29711}"
TENSORBOARD_PORT="${TENSORBOARD_PORT:-6007}"
