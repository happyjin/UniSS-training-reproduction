# Isolated continuation of v5 using the legacy non-simultaneous Phase3
# startup scan. Existing v5 data, checkpoint, logs, and TensorBoard are read-only.

USER_ROOT="${USER_ROOT:-/opt/dlami/nvme/jasonleeeli}"
ACTIVATE_SCRIPT="${ACTIVATE_SCRIPT:-${USER_ROOT}/env_recovery/uniss-train-20260721/activate_uniss.sh}"
SIMUL_EXPERIMENT="${SIMUL_EXPERIMENT:-simul_uniss_v6_full198_phase3_index_scan_stage3}"

SOURCE_PACKED_DIR="${SOURCE_PACKED_DIR:-${REPO_ROOT}/data/megatron/simul_uniss_v3_full198}"
ACTION_PACKED_TRAIN="${ACTION_PACKED_TRAIN:-${SOURCE_PACKED_DIR}/packed_action_train.jsonl}"
PACKED_TRAIN="${PACKED_TRAIN:-${SOURCE_PACKED_DIR}/packed_interleaved_train.jsonl}"
FULL_DATA_READY_MARKER="${FULL_DATA_READY_MARKER:-${SOURCE_PACKED_DIR}/FULL_DATA_READY.json}"

SEQ_LENGTH="${SEQ_LENGTH:-4096}"
RUN_DIR="${RUN_DIR:-${REPO_ROOT}/runs/${SIMUL_EXPERIMENT}}"
TENSORBOARD_DIR="${TENSORBOARD_DIR:-${RUN_DIR}/tensorboard}"
LOG_DIR="${LOG_DIR:-${REPO_ROOT}/logs/${SIMUL_EXPERIMENT}}"
SIMUL_CHECKPOINT_ROOT="${SIMUL_CHECKPOINT_ROOT:-${REPO_ROOT}/checkpoints/${SIMUL_EXPERIMENT}}"
TRAINING_SCHEDULE_FILE="${TRAINING_SCHEDULE_FILE:-${REPO_ROOT}/data/megatron/simul_uniss_v5_full198_mbs4_gbs128_stage3/training_schedule.env}"

V5_CHECKPOINT_ROOT="${V5_CHECKPOINT_ROOT:-${REPO_ROOT}/checkpoints/simul_uniss_v5_full198_mbs4_gbs128_stage3/stage03_action_sft}"
VALID_PACKED_DIR="${VALID_PACKED_DIR:-${REPO_ROOT}/data/megatron/simul_uniss_v1/validation_dev}"
VALID_PACKED_ACTION="${VALID_PACKED_ACTION:-${VALID_PACKED_DIR}/packed_action_valid.jsonl}"
VALID_PACKED_INTERLEAVED="${VALID_PACKED_INTERLEAVED:-${VALID_PACKED_DIR}/packed_interleaved_valid.jsonl}"

TENSORBOARD_PORT="${TENSORBOARD_PORT:-6020}"
TENSORBOARD_SESSION="${TENSORBOARD_SESSION:-simul_uniss_v6_full198_phase3_index_scan_tensorboard}"

SIMUL_CUDA_VISIBLE_DEVICES="${SIMUL_CUDA_VISIBLE_DEVICES:-0,1,2,3,4,5,6,7}"
SIMUL_NPROC_PER_NODE="${SIMUL_NPROC_PER_NODE:-8}"
SIMUL_MICRO_BATCH_SIZE="${SIMUL_MICRO_BATCH_SIZE:-4}"
SIMUL_GLOBAL_BATCH_SIZE="${SIMUL_GLOBAL_BATCH_SIZE:-128}"
SIMUL_DATALOADER_TYPE="${SIMUL_DATALOADER_TYPE:-cyclic}"
SIMUL_NO_DATA_SHARDING="${SIMUL_NO_DATA_SHARDING:-1}"
SIMUL_FULL_VALIDATION="${SIMUL_FULL_VALIDATION:-1}"
SIMUL_DATA_SEED="${SIMUL_DATA_SEED:-20260730}"

# Reproduce the old Phase3 behavior: scan JSONL once per process and retain
# offsets in a Python list. This intentionally bypasses the sidecar index.
SIMUL_OFFSET_INDEX_MODE="${SIMUL_OFFSET_INDEX_MODE:-phase3-scan}"

# Resume iteration, optimizer/scheduler, and RNG from the complete v5
# iteration-500 checkpoint instead of restarting a finetune schedule.
SIMUL_NO_LOAD_OPTIM="${SIMUL_NO_LOAD_OPTIM:-0}"
SIMUL_NO_LOAD_RNG="${SIMUL_NO_LOAD_RNG:-0}"
SIMUL_FINETUNE="${SIMUL_FINETUNE:-0}"

SIMUL_QWEN_LR="${SIMUL_QWEN_LR:-1e-5}"
SIMUL_QWEN_MIN_LR="${SIMUL_QWEN_MIN_LR:-1e-6}"
SIMUL_QWEN_SAVE_INTERVAL="${SIMUL_QWEN_SAVE_INTERVAL:-500}"
SIMUL_QWEN_EVAL_INTERVAL="${SIMUL_QWEN_EVAL_INTERVAL:-500}"
SIMUL_QWEN_EVAL_ITERS="${SIMUL_QWEN_EVAL_ITERS:-1}"
SIMUL_QWEN_LOG_INTERVAL="${SIMUL_QWEN_LOG_INTERVAL:-10}"
SIMUL_QWEN_TENSORBOARD_LOG_INTERVAL="${SIMUL_QWEN_TENSORBOARD_LOG_INTERVAL:-10}"
SIMUL_QWEN_TENSORBOARD_MEMORY_INTERVAL="${SIMUL_QWEN_TENSORBOARD_MEMORY_INTERVAL:-10}"

STAGE3_LOAD_ROOT="${STAGE3_LOAD_ROOT:-${V5_CHECKPOINT_ROOT}}"
STAGE3_SAVE_ROOT="${STAGE3_SAVE_ROOT:-${SIMUL_CHECKPOINT_ROOT}/stage03_action_sft}"
STAGE3_TENSORBOARD_DIR="${STAGE3_TENSORBOARD_DIR:-${TENSORBOARD_DIR}/stage03_action_sft}"
STAGE3_MASTER_PORT="${STAGE3_MASTER_PORT:-30032}"

if [[ -f "${TRAINING_SCHEDULE_FILE}" ]]; then
  # shellcheck source=/dev/null
  source "${TRAINING_SCHEDULE_FILE}"
fi
