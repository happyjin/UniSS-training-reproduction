#!/usr/bin/env bash

USER_ROOT="${USER_ROOT:-/opt/dlami/nvme/jasonleeeli}"
REPO_ROOT="${REPO_ROOT:-${USER_ROOT}/projects/UniSS}"
ENV_ROOT="${ENV_ROOT:-${USER_ROOT}/conda_envs/uniss-train}"
PYTHON="${PYTHON:-${ENV_ROOT}/bin/python}"

EXPERIMENT_NAME="${EXPERIMENT_NAME:-uniss_phase3_dense_aligned_streaming_pilot15_v1}"
EXPERIMENT_DIR="${REPO_ROOT}/experiments/uniss_phase3_dense_aligned_streaming_pilot15_v1"
FORMAL_ROOT="${REPO_ROOT}/data/processed/simul_uniss_subsecond_v2/formal_15shard_v1/stage_a_formal"
FORMAL_TRAIN="${FORMAL_TRAIN:-${FORMAL_ROOT}/formal_train_manifest.jsonl}"
FORMAL_VALID="${FORMAL_VALID:-${FORMAL_ROOT}/formal_valid_manifest.jsonl}"

DATA_ROOT="${DATA_ROOT:-${REPO_ROOT}/data/processed/${EXPERIMENT_NAME}}"
DENSE_TRAIN="${DENSE_TRAIN:-${DATA_ROOT}/dense_train.jsonl}"
DENSE_VALID="${DENSE_VALID:-${DATA_ROOT}/dense_valid.jsonl}"
TRAIN_PARTS_ROOT="${TRAIN_PARTS_ROOT:-${DATA_ROOT}/train_parts}"
VALID_PARTS_ROOT="${VALID_PARTS_ROOT:-${DATA_ROOT}/valid_parts}"

PHASE3_MODEL="${PHASE3_MODEL:-${REPO_ROOT}/checkpoints/exported_hf/qwen0p5b_phase3_unist198_iter_0009075_hf}"
PHASE3_NATIVE_CHECKPOINT="${PHASE3_NATIVE_CHECKPOINT:-${REPO_ROOT}/checkpoints/uniss_qwen0p5b_phase3_unist198_after_phase2_v4}"
SPEECH_TOKENIZER="${SPEECH_TOKENIZER:-${REPO_ROOT}/pretrained_models/UniSS}"
WHISPERVQ_CODEBOOK="${WHISPERVQ_CODEBOOK:-${SPEECH_TOKENIZER}/glm4_tokenizer/model.safetensors}"
PHASE3_FINGERPRINT="${PHASE3_FINGERPRINT:-${REPO_ROOT}/data/processed/uniss_phase3_true_subsecond_deadline_full198_v1/model_handoff/phase3_embedding_fingerprint.json}"
PHASE3_REPLAY_PACKED="${PHASE3_REPLAY_PACKED:-${REPO_ROOT}/data/megatron/uniss_true_subsecond_pilot15_v1/packed_replay.jsonl}"
PHASE3_REPLAY_OFFSETS="${PHASE3_REPLAY_OFFSETS:-${REPO_ROOT}/data/megatron/uniss_true_subsecond_pilot15_v1/packed_replay.offsets.u64}"
VALID_REPLAY_PACKED="${VALID_REPLAY_PACKED:-${REPO_ROOT}/data/megatron/validation_unist_dev/phase3_valid_packed.jsonl}"
VALID_REPLAY_OFFSETS="${VALID_REPLAY_OFFSETS:-${REPO_ROOT}/data/processed/uniss_phase3_true_subsecond_deadline_full198_v1/validation/phase3_valid.u64}"

PACKED_ROOT="${PACKED_ROOT:-${REPO_ROOT}/data/megatron/${EXPERIMENT_NAME}}"
PACK_PARTS_ROOT="${PACK_PARTS_ROOT:-${DATA_ROOT}/pack_parts}"
VALID_PACK_PARTS_ROOT="${VALID_PACK_PARTS_ROOT:-${DATA_ROOT}/valid_pack_parts}"
TRAJECTORY_PACKED="${TRAJECTORY_PACKED:-${PACKED_ROOT}/packed_dense_train.jsonl}"
TRAJECTORY_OFFSETS="${TRAJECTORY_OFFSETS:-${TRAJECTORY_PACKED}.offsets.bin}"
VALID_TRAJECTORY_PACKED="${VALID_TRAJECTORY_PACKED:-${PACKED_ROOT}/packed_dense_valid.jsonl}"
VALID_TRAJECTORY_OFFSETS="${VALID_TRAJECTORY_OFFSETS:-${VALID_TRAJECTORY_PACKED}.offsets.bin}"

SAVE_DIR="${SAVE_DIR:-${REPO_ROOT}/checkpoints/${EXPERIMENT_NAME}}"
RUN_DIR="${RUN_DIR:-${REPO_ROOT}/runs/${EXPERIMENT_NAME}}"
TB_DIR="${TB_DIR:-${RUN_DIR}/tensorboard}"
LOG_PATH="${LOG_PATH:-${REPO_ROOT}/logs/${EXPERIMENT_NAME}.log}"
REPORT_ROOT="${REPORT_ROOT:-${REPO_ROOT}/reports/${EXPERIMENT_NAME}}"
TRAINING_MANIFEST="${TRAINING_MANIFEST:-${PACKED_ROOT}/training_manifest.json}"
SHUFFLE_AUDIT="${SHUFFLE_AUDIT:-${PACKED_ROOT}/shuffle_audit.json}"
REPLAY_SUBSET_OFFSETS="${REPLAY_SUBSET_OFFSETS:-${PACKED_ROOT}/replay_subset.u64}"

TRAIN_DATA_WORKERS="${TRAIN_DATA_WORKERS:-32}"
VALID_DATA_WORKERS="${VALID_DATA_WORKERS:-4}"
LOW_WATERMARK_MS="${LOW_WATERMARK_MS:-240}"
TARGET_BUFFER_MS="${TARGET_BUFFER_MS:-400}"
SEMANTIC_HISTORY_TOKENS="${SEMANTIC_HISTORY_TOKENS:-200}"

CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0,1,2,3,4,5,6,7}"
NPROC_PER_NODE="${NPROC_PER_NODE:-8}"
MASTER_PORT="${MASTER_PORT:-29731}"
TENSORBOARD_PORT="${TENSORBOARD_PORT:-6073}"
MICRO_BATCH_SIZE="${MICRO_BATCH_SIZE:-2}"
GLOBAL_BATCH_SIZE="${GLOBAL_BATCH_SIZE:-128}"
SEQ_LENGTH="${SEQ_LENGTH:-18000}"
COVERAGE_EPOCHS="${COVERAGE_EPOCHS:-3}"
REPLAY_FRACTION="${REPLAY_FRACTION:-0.35}"
SEED="${SEED:-20260811}"
LR_QWEN_LORA="${LR_QWEN_LORA:-1e-5}"
LR_FRONTEND="${LR_FRONTEND:-5e-6}"
LR_NEW_HEADS="${LR_NEW_HEADS:-5e-5}"
