# Isolated full198 Stage4 end-to-end streaming dev evaluation.

USER_ROOT="${USER_ROOT:-/opt/dlami/nvme/jasonleeeli}"
REPO_ROOT="${REPO_ROOT:-${USER_ROOT}/projects/UniSS}"
TRAIN_ENV="${TRAIN_ENV:-${USER_ROOT}/conda_envs/uniss-train}"
EVAL_ENV="${EVAL_ENV:-${USER_ROOT}/conda_envs/uniss-eval}"
EXPERIMENT_NAME="${EXPERIMENT_NAME:-simul_uniss_stage4_streaming_v1}"

STAGE4_ROOT="${STAGE4_ROOT:-${REPO_ROOT}/checkpoints/simul_uniss_v8_full198_seq18000_mbs2_gbs128_stage4_stage6/stage04_interleaved_s2st}"
STAGE4_ITERATION="${STAGE4_ITERATION:-4753}"
HF_REFERENCE="${HF_REFERENCE:-${REPO_ROOT}/checkpoints/qwen2_0p5b_uniss_vocab_hf}"
HF_EXPORT="${HF_EXPORT:-${REPO_ROOT}/checkpoints/exported_hf/${EXPERIMENT_NAME}_iter_0004753_hf}"

DEV_SCHEDULES="${DEV_SCHEDULES:-${REPO_ROOT}/data/processed/simul_uniss_v1/validation_dev/schedules.jsonl}"
OFFLINE_DEV_MANIFEST="${OFFLINE_DEV_MANIFEST:-${REPO_ROOT}/experiments/evaluation/uniss_full198_phase2_phase3/manifests/unist_dev_all.jsonl}"
OFFLINE_PHASE3_DEV="${OFFLINE_PHASE3_DEV:-${REPO_ROOT}/eval_outputs/qwen0p5b_phase3_unist198_iter_0009075_unist_dev_full_20260726T065924Z}"
SPEECH_TOKENIZER="${SPEECH_TOKENIZER:-${REPO_ROOT}/pretrained_models/UniSS}"

DEV_GPUS="${DEV_GPUS:-0,1,2,3}"
EXPECTED_DEV_RECORDS="${EXPECTED_DEV_RECORDS:-7965}"

BATCH_RECORDS="${BATCH_RECORDS:-512}"
MAX_WRITE_TOKENS="${MAX_WRITE_TOKENS:-700}"
REPETITION_PENALTY="${REPETITION_PENALTY:-1.1}"
# The teacher-forced Stage4 training envelope is 18k, while free-running output
# can be longer when the model emits more WRITE chunks than the reference.  Use
# Qwen's native context so those failures are measured rather than crashed or
# truncated, and record every sample that crosses the 18k training boundary.
MAX_MODEL_LEN="${MAX_MODEL_LEN:-32768}"
TRAINING_CONTEXT_LIMIT="${TRAINING_CONTEXT_LIMIT:-18000}"
MAX_NUM_SEQS="${MAX_NUM_SEQS:-512}"
MAX_NUM_BATCHED_TOKENS="${MAX_NUM_BATCHED_TOKENS:-262144}"
MAX_SEQ_LEN_TO_CAPTURE="${MAX_SEQ_LEN_TO_CAPTURE:-2048}"
GPU_MEMORY_UTILIZATION="${GPU_MEMORY_UTILIZATION:-0.90}"
DECODE_BATCH_SIZE="${DECODE_BATCH_SIZE:-16}"

LEFT_CONTEXT_TOKENS="${LEFT_CONTEXT_TOKENS:-50}"
HOLDBACK_TOKENS="${HOLDBACK_TOKENS:-5}"
OVERLAP_MS="${OVERLAP_MS:-80}"

OUTPUT_ROOT="${OUTPUT_ROOT:-${REPO_ROOT}/eval_outputs/${EXPERIMENT_NAME}}"
