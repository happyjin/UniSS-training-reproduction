TEST_GPUS="${TEST_GPUS:-4,5,6,7}"
EXPECTED_TEST_RECORDS="${EXPECTED_TEST_RECORDS:-23369}"
OUTPUT_ROOT="${OUTPUT_ROOT:-${REPO_ROOT}/eval_outputs/${EXPERIMENT_NAME}}"

export DEV_GPUS="${TEST_GPUS}"
export DEV_SCHEDULES="${TEST_SCHEDULES}"
export OFFLINE_DEV_MANIFEST="${OFFLINE_TEST_MANIFEST}"
