# Isolated Simul-UniSS v2 experiment using the existing 15-shard prepared data.
# Generated checkpoints, logs, runs, and TensorBoard events never reuse v1 paths.

USER_ROOT="${USER_ROOT:-/opt/dlami/nvme/jasonleeeli}"
ACTIVATE_SCRIPT="${ACTIVATE_SCRIPT:-${USER_ROOT}/env_recovery/uniss-train-20260721/activate_uniss.sh}"

SIMUL_EXPERIMENT="${SIMUL_EXPERIMENT:-simul_uniss_v2_15shard}"
RUN_DIR="${RUN_DIR:-${REPO_ROOT}/runs/simul_uniss_v2_15shard}"
TENSORBOARD_DIR="${TENSORBOARD_DIR:-${RUN_DIR}/tensorboard}"
LOG_DIR="${LOG_DIR:-${REPO_ROOT}/logs/simul_uniss_v2_15shard}"
SIMUL_CHECKPOINT_ROOT="${SIMUL_CHECKPOINT_ROOT:-${REPO_ROOT}/checkpoints/simul_uniss_v2_15shard}"

# Read-only initialization from the completed clean UniST198 Phase3 checkpoint.
QWEN_CHECKPOINT_ROOT="${QWEN_CHECKPOINT_ROOT:-${REPO_ROOT}/checkpoints/uniss_qwen0p5b_phase3_unist198_after_phase2_v4}"

TENSORBOARD_PORT="${TENSORBOARD_PORT:-6016}"
TENSORBOARD_SESSION="${TENSORBOARD_SESSION:-simul_uniss_v2_15shard_tensorboard}"

# Define experiment-specific stage settings before loading the reusable v1
# data configuration. The base file uses default-only assignments and therefore
# preserves every value set here or by a caller such as the smoke launcher.
SIMUL_CUDA_VISIBLE_DEVICES="${SIMUL_CUDA_VISIBLE_DEVICES:-0,1,2,3,4,5,6,7}"
SIMUL_NPROC_PER_NODE="${SIMUL_NPROC_PER_NODE:-8}"
SIMUL_DATALOADER_TYPE="${SIMUL_DATALOADER_TYPE:-cyclic}"
SIMUL_NO_DATA_SHARDING="${SIMUL_NO_DATA_SHARDING:-1}"
SIMUL_DATA_SEED="${SIMUL_DATA_SEED:-20260725}"
SIMUL_FULL_VALIDATION="${SIMUL_FULL_VALIDATION:-1}"
SIMUL_QWEN_SAVE_INTERVAL="${SIMUL_QWEN_SAVE_INTERVAL:-50}"
SIMUL_QWEN_EVAL_INTERVAL="${SIMUL_QWEN_EVAL_INTERVAL:-50}"
SIMUL_QWEN_EVAL_ITERS="${SIMUL_QWEN_EVAL_ITERS:-1}"

STAGE1_TOKEN_OUTPUT_DIR="${STAGE1_TOKEN_OUTPUT_DIR:-${SIMUL_CHECKPOINT_ROOT}/stage01_02_streaming_token_student}"
STAGE1_TOKEN_TENSORBOARD_DIR="${STAGE1_TOKEN_TENSORBOARD_DIR:-${TENSORBOARD_DIR}/stage01_02_streaming_token_student}"
STAGE1_TOKEN_MASTER_PORT="${STAGE1_TOKEN_MASTER_PORT:-29721}"

STAGE3_SAVE_ROOT="${STAGE3_SAVE_ROOT:-${SIMUL_CHECKPOINT_ROOT}/stage03_action_sft}"
STAGE3_TENSORBOARD_DIR="${STAGE3_TENSORBOARD_DIR:-${TENSORBOARD_DIR}/stage03_action_sft}"
STAGE3_MASTER_PORT="${STAGE3_MASTER_PORT:-29731}"
STAGE3_TRAIN_ITERS="${STAGE3_TRAIN_ITERS:-200}"

STAGE4_LOAD_ROOT="${STAGE4_LOAD_ROOT:-${STAGE3_SAVE_ROOT}}"
STAGE4_SAVE_ROOT="${STAGE4_SAVE_ROOT:-${SIMUL_CHECKPOINT_ROOT}/stage04_interleaved_s2st}"
STAGE4_TENSORBOARD_DIR="${STAGE4_TENSORBOARD_DIR:-${TENSORBOARD_DIR}/stage04_interleaved_s2st}"
STAGE4_MASTER_PORT="${STAGE4_MASTER_PORT:-29732}"
STAGE4_TRAIN_ITERS="${STAGE4_TRAIN_ITERS:-500}"

STAGE6_LOAD_ROOT="${STAGE6_LOAD_ROOT:-${STAGE4_SAVE_ROOT}}"
STAGE6_SAVE_ROOT="${STAGE6_SAVE_ROOT:-${SIMUL_CHECKPOINT_ROOT}/stage06_joint_refinement}"
STAGE6_TENSORBOARD_DIR="${STAGE6_TENSORBOARD_DIR:-${TENSORBOARD_DIR}/stage06_joint_refinement}"
STAGE6_MASTER_PORT="${STAGE6_MASTER_PORT:-29733}"
STAGE6_TRAIN_ITERS="${STAGE6_TRAIN_ITERS:-200}"

# Reuse v1 prepared input data read-only. It is roughly 40 GB and should not be
# copied merely to create a new training namespace.
BASE_CONFIG="${REPO_ROOT}/configs/experiments/simul_uniss_v1/bootstrap_15shard.env"
# shellcheck source=/dev/null
source "${BASE_CONFIG}"
