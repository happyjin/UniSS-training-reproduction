# Isolated full-data Simul-UniSS experiment over UniST train shards 00000-00197.
# This file never redirects outputs into v1/v2 namespaces.

USER_ROOT="${USER_ROOT:-/opt/dlami/nvme/jasonleeeli}"
ACTIVATE_SCRIPT="${ACTIVATE_SCRIPT:-${USER_ROOT}/env_recovery/uniss-train-20260721/activate_uniss.sh}"

SIMUL_EXPERIMENT="${SIMUL_EXPERIMENT:-simul_uniss_v3_full198}"
UNIST_ROOT="${UNIST_ROOT:-${REPO_ROOT}/data/raw/UniST}"
TOKENIZER_DIR="${TOKENIZER_DIR:-${REPO_ROOT}/pretrained_models/UniSS}"
SHARD_START="${SHARD_START:-0}"
SHARD_COUNT="${SHARD_COUNT:-198}"
PREPARE_WORKERS="${PREPARE_WORKERS:-8}"
PACK_WORKERS="${PACK_WORKERS:-4}"

CHUNK_MS="${CHUNK_MS:-640}"
WAIT_K_CHUNKS="${WAIT_K_CHUNKS:-2}"
MAX_PHRASE_TOKENS="${MAX_PHRASE_TOKENS:-16}"
SEQ_LENGTH="${SEQ_LENGTH:-4096}"

PROCESSED_DIR="${PROCESSED_DIR:-${REPO_ROOT}/data/processed/simul_uniss_v3_full198}"
PACKED_DIR="${PACKED_DIR:-${REPO_ROOT}/data/megatron/simul_uniss_v3_full198}"
PREPARED_PARTS_DIR="${PREPARED_PARTS_DIR:-${PROCESSED_DIR}/parts}"
PACKED_PARTS_DIR="${PACKED_PARTS_DIR:-${PACKED_DIR}/parts}"
SCHEDULES_JSONL="${SCHEDULES_JSONL:-${PROCESSED_DIR}/schedules.jsonl}"
PACKED_TRAIN="${PACKED_TRAIN:-${PACKED_DIR}/packed_interleaved_train.jsonl}"
ACTION_PACKED_TRAIN="${ACTION_PACKED_TRAIN:-${PACKED_DIR}/packed_action_train.jsonl}"
FULL_DATA_MANIFEST="${FULL_DATA_MANIFEST:-${PROCESSED_DIR}/full_data_manifest.json}"
DATA_ASSEMBLY_MARKER="${DATA_ASSEMBLY_MARKER:-${PACKED_DIR}/DATA_ASSEMBLY_COMPLETE.json}"
FULL_DATA_READY_MARKER="${FULL_DATA_READY_MARKER:-${PACKED_DIR}/FULL_DATA_READY.json}"
TRAINING_SCHEDULE_FILE="${TRAINING_SCHEDULE_FILE:-${PACKED_DIR}/training_schedule.env}"

RUN_DIR="${RUN_DIR:-${REPO_ROOT}/runs/simul_uniss_v3_full198}"
TENSORBOARD_DIR="${TENSORBOARD_DIR:-${RUN_DIR}/tensorboard}"
LOG_DIR="${LOG_DIR:-${REPO_ROOT}/logs/simul_uniss_v3_full198}"
SIMUL_CHECKPOINT_ROOT="${SIMUL_CHECKPOINT_ROOT:-${REPO_ROOT}/checkpoints/simul_uniss_v3_full198}"
STAGE0_METRICS="${STAGE0_METRICS:-${RUN_DIR}/stage00_schedule_metrics.json}"
STAGE0_EVAL_RECORDS="${STAGE0_EVAL_RECORDS:-10000}"

# Initialization is read-only from the completed full UniST198 Phase3 v4 run.
QWEN_CHECKPOINT_ROOT="${QWEN_CHECKPOINT_ROOT:-${REPO_ROOT}/checkpoints/uniss_qwen0p5b_phase3_unist198_after_phase2_v4}"

# Reuse the fixed dev set and stable policy tokenizer read-only. Rebuilding either
# would make v2/full198 comparisons needlessly confounded.
VALID_PROCESSED_DIR="${VALID_PROCESSED_DIR:-${REPO_ROOT}/data/processed/simul_uniss_v1/validation_dev}"
VALID_PACKED_DIR="${VALID_PACKED_DIR:-${REPO_ROOT}/data/megatron/simul_uniss_v1/validation_dev}"
VALID_SCHEDULES_JSONL="${VALID_SCHEDULES_JSONL:-${VALID_PROCESSED_DIR}/schedules.jsonl}"
VALID_PACKED_INTERLEAVED="${VALID_PACKED_INTERLEAVED:-${VALID_PACKED_DIR}/packed_interleaved_valid.jsonl}"
VALID_PACKED_ACTION="${VALID_PACKED_ACTION:-${VALID_PACKED_DIR}/packed_action_valid.jsonl}"
POLICY_TOKENIZER_MODEL="${POLICY_TOKENIZER_MODEL:-${REPO_ROOT}/data/processed/simul_uniss_v1/bootstrap_15shard/policy_tokenizer/policy_8k.model}"
GLM_TOKENIZER_DIR="${GLM_TOKENIZER_DIR:-${REPO_ROOT}/pretrained_models/UniSS/glm4_tokenizer}"
BICODEC_MODEL_DIR="${BICODEC_MODEL_DIR:-${REPO_ROOT}/pretrained_models/UniSS/bicodec}"

TENSORBOARD_PORT="${TENSORBOARD_PORT:-6017}"
TENSORBOARD_SESSION="${TENSORBOARD_SESSION:-simul_uniss_v3_full198_tensorboard}"

SIMUL_CUDA_VISIBLE_DEVICES="${SIMUL_CUDA_VISIBLE_DEVICES:-0,1,2,3,4,5,6,7}"
SIMUL_NPROC_PER_NODE="${SIMUL_NPROC_PER_NODE:-8}"
SIMUL_MASTER_ADDR="${SIMUL_MASTER_ADDR:-127.0.0.1}"
SIMUL_MICRO_BATCH_SIZE="${SIMUL_MICRO_BATCH_SIZE:-1}"
SIMUL_GLOBAL_BATCH_SIZE="${SIMUL_GLOBAL_BATCH_SIZE:-32}"
SIMUL_DATALOADER_TYPE="${SIMUL_DATALOADER_TYPE:-cyclic}"
SIMUL_NO_DATA_SHARDING="${SIMUL_NO_DATA_SHARDING:-1}"
SIMUL_FULL_VALIDATION="${SIMUL_FULL_VALIDATION:-1}"
SIMUL_DATA_SEED="${SIMUL_DATA_SEED:-20260725}"
SIMUL_QWEN_LR="${SIMUL_QWEN_LR:-1e-5}"
SIMUL_QWEN_MIN_LR="${SIMUL_QWEN_MIN_LR:-1e-6}"
SIMUL_QWEN_WARMUP_ITERS="${SIMUL_QWEN_WARMUP_ITERS:-10}"
SIMUL_QWEN_SAVE_INTERVAL="${SIMUL_QWEN_SAVE_INTERVAL:-500}"
SIMUL_QWEN_EVAL_INTERVAL="${SIMUL_QWEN_EVAL_INTERVAL:-500}"
SIMUL_QWEN_EVAL_ITERS="${SIMUL_QWEN_EVAL_ITERS:-1}"

# Initial full-data protocol. The exact iteration counts are generated only
# after packing, from real line counts rather than the 15-shard short-run values.
FULL_STAGE3_EPOCHS="${FULL_STAGE3_EPOCHS:-1.0}"
FULL_STAGE4_EPOCHS="${FULL_STAGE4_EPOCHS:-1.0}"
FULL_STAGE6_EPOCHS="${FULL_STAGE6_EPOCHS:-0.25}"
FULL_WARMUP_FRACTION="${FULL_WARMUP_FRACTION:-0.05}"

STAGE0_AUDIO_DIR="${STAGE0_AUDIO_DIR:-${PROCESSED_DIR}/stage00_audio_stratified}"
STAGE0_PREFIX_DIR="${STAGE0_PREFIX_DIR:-${RUN_DIR}/stage00_prefix_baseline}"
STAGE0_PREFIX_TENSORBOARD_DIR="${STAGE0_PREFIX_TENSORBOARD_DIR:-${TENSORBOARD_DIR}/stage00_prefix_baseline}"
STAGE0_RECORDS_PER_SHARD="${STAGE0_RECORDS_PER_SHARD:-5}"
STAGE0_RECONSTRUCT_RECORDS="${STAGE0_RECONSTRUCT_RECORDS:-990}"
STAGE0_PREFIX_RECORDS="${STAGE0_PREFIX_RECORDS:-100}"

STAGE1_TOKEN_OUTPUT_DIR="${STAGE1_TOKEN_OUTPUT_DIR:-${SIMUL_CHECKPOINT_ROOT}/stage01_02_streaming_token_student}"
STAGE1_TOKEN_TENSORBOARD_DIR="${STAGE1_TOKEN_TENSORBOARD_DIR:-${TENSORBOARD_DIR}/stage01_02_streaming_token_student}"
STAGE1_TOKEN_MASTER_PORT="${STAGE1_TOKEN_MASTER_PORT:-29821}"
STAGE1_BATCH_SIZE="${STAGE1_BATCH_SIZE:-2}"
STAGE1_MAX_STEPS="${STAGE1_MAX_STEPS:-10000}"
STAGE1_LEARNING_RATE="${STAGE1_LEARNING_RATE:-1e-4}"
STAGE1_HIDDEN_SIZE="${STAGE1_HIDDEN_SIZE:-256}"
STAGE1_NUM_LAYERS="${STAGE1_NUM_LAYERS:-4}"
STAGE1_NUM_HEADS="${STAGE1_NUM_HEADS:-8}"
STAGE1_MAX_SOURCE_TOKENS="${STAGE1_MAX_SOURCE_TOKENS:-1024}"
STAGE1_VALIDATION_RECORDS="${STAGE1_VALIDATION_RECORDS:-128}"
STAGE1_EVAL_INTERVAL="${STAGE1_EVAL_INTERVAL:-100}"
STAGE1_SAVE_INTERVAL="${STAGE1_SAVE_INTERVAL:-100}"
STAGE1_AUDIO_OUTPUT_DIR="${STAGE1_AUDIO_OUTPUT_DIR:-${SIMUL_CHECKPOINT_ROOT}/stage01_02_streaming_audio_student}"
STAGE1_AUDIO_TENSORBOARD_DIR="${STAGE1_AUDIO_TENSORBOARD_DIR:-${TENSORBOARD_DIR}/stage01_02_streaming_audio_student}"
STAGE1_AUDIO_MASTER_PORT="${STAGE1_AUDIO_MASTER_PORT:-29822}"
STAGE1_AUDIO_BATCH_SIZE="${STAGE1_AUDIO_BATCH_SIZE:-2}"
STAGE1_AUDIO_MAX_STEPS="${STAGE1_AUDIO_MAX_STEPS:-1000}"

STAGE3_LOAD_ROOT="${STAGE3_LOAD_ROOT:-${QWEN_CHECKPOINT_ROOT}}"
STAGE3_SAVE_ROOT="${STAGE3_SAVE_ROOT:-${SIMUL_CHECKPOINT_ROOT}/stage03_action_sft}"
STAGE3_TENSORBOARD_DIR="${STAGE3_TENSORBOARD_DIR:-${TENSORBOARD_DIR}/stage03_action_sft}"
STAGE3_MASTER_PORT="${STAGE3_MASTER_PORT:-29831}"

STAGE4_LOAD_ROOT="${STAGE4_LOAD_ROOT:-${STAGE3_SAVE_ROOT}}"
STAGE4_SAVE_ROOT="${STAGE4_SAVE_ROOT:-${SIMUL_CHECKPOINT_ROOT}/stage04_interleaved_s2st}"
STAGE4_TENSORBOARD_DIR="${STAGE4_TENSORBOARD_DIR:-${TENSORBOARD_DIR}/stage04_interleaved_s2st}"
STAGE4_MASTER_PORT="${STAGE4_MASTER_PORT:-29832}"

STAGE6_LOAD_ROOT="${STAGE6_LOAD_ROOT:-${STAGE4_SAVE_ROOT}}"
STAGE6_SAVE_ROOT="${STAGE6_SAVE_ROOT:-${SIMUL_CHECKPOINT_ROOT}/stage06_joint_refinement}"
STAGE6_TENSORBOARD_DIR="${STAGE6_TENSORBOARD_DIR:-${TENSORBOARD_DIR}/stage06_joint_refinement}"
STAGE6_MASTER_PORT="${STAGE6_MASTER_PORT:-29833}"
STAGE6_QWEN_LR="${STAGE6_QWEN_LR:-3e-6}"
STAGE6_QWEN_MIN_LR="${STAGE6_QWEN_MIN_LR:-5e-7}"

STAGE5_OUTPUT_DIR="${STAGE5_OUTPUT_DIR:-${RUN_DIR}/stage05_streaming_bicodec}"
STAGE5_TENSORBOARD_DIR="${STAGE5_TENSORBOARD_DIR:-${TENSORBOARD_DIR}/stage05_streaming_bicodec}"
STAGE5_REFINEMENT_OUTPUT_DIR="${STAGE5_REFINEMENT_OUTPUT_DIR:-${SIMUL_CHECKPOINT_ROOT}/stage05_bicodec_refinement}"
STAGE5_REFINEMENT_TENSORBOARD_DIR="${STAGE5_REFINEMENT_TENSORBOARD_DIR:-${TENSORBOARD_DIR}/stage05_bicodec_refinement}"
STAGE5_REFINEMENT_MASTER_PORT="${STAGE5_REFINEMENT_MASTER_PORT:-29825}"
STAGE5_REFINEMENT_BATCH_SIZE="${STAGE5_REFINEMENT_BATCH_SIZE:-1}"
STAGE5_REFINEMENT_MAX_STEPS="${STAGE5_REFINEMENT_MAX_STEPS:-1000}"

STAGE7_OUTPUT_DIR="${STAGE7_OUTPUT_DIR:-${SIMUL_CHECKPOINT_ROOT}/stage07_grpo_policy_bootstrap}"
STAGE7_TENSORBOARD_DIR="${STAGE7_TENSORBOARD_DIR:-${TENSORBOARD_DIR}/stage07_grpo_policy_bootstrap}"
STAGE7_MASTER_PORT="${STAGE7_MASTER_PORT:-29827}"
STAGE7_BATCH_SIZE="${STAGE7_BATCH_SIZE:-128}"
STAGE7_SFT_STEPS="${STAGE7_SFT_STEPS:-1000}"
STAGE7_GRPO_STEPS="${STAGE7_GRPO_STEPS:-2000}"
STAGE7_GROUP_SIZE="${STAGE7_GROUP_SIZE:-8}"
SIMUL_ITERABLE_SHUFFLE_BUFFER_SIZE="${SIMUL_ITERABLE_SHUFFLE_BUFFER_SIZE:-65536}"

STAGE8_OUTPUT_DIR="${STAGE8_OUTPUT_DIR:-${SIMUL_CHECKPOINT_ROOT}/stage08_nar_semantic_optional}"
STAGE8_TENSORBOARD_DIR="${STAGE8_TENSORBOARD_DIR:-${TENSORBOARD_DIR}/stage08_nar_semantic_optional}"
STAGE8_MASTER_PORT="${STAGE8_MASTER_PORT:-29828}"
STAGE8_BATCH_SIZE="${STAGE8_BATCH_SIZE:-8}"
STAGE8_MAX_STEPS="${STAGE8_MAX_STEPS:-5000}"

if [[ -f "${TRAINING_SCHEDULE_FILE}" ]]; then
  # shellcheck source=/dev/null
  source "${TRAINING_SCHEDULE_FILE}"
fi
