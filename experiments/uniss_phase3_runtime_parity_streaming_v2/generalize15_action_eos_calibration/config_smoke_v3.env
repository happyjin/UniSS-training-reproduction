#!/usr/bin/env bash

V15_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "${V15_DIR}/config_canary.env"

EXPERIMENT_NAME="uniss_phase3_runtime_parity_streaming_v2_generalize15_action_eos_calibration_smoke_v3"
PHASE3_NATIVE_CHECKPOINT="${REPO_ROOT}/checkpoints/${EXPERIMENT_NAME}_v14_iter50_base"
TRAINING_ROOT="${REPO_ROOT}/data/megatron/${EXPERIMENT_NAME}/training"
TRAINING_MANIFEST="${TRAINING_ROOT}/training_manifest.json"
REPLAY_SUBSET_OFFSETS="${TRAINING_ROOT}/replay_subset.u64"
SAVE_DIR="${REPO_ROOT}/checkpoints/${EXPERIMENT_NAME}"
RUN_DIR="${REPO_ROOT}/runs/${EXPERIMENT_NAME}"
TB_DIR="${RUN_DIR}/tensorboard"
LOG_PATH="${REPO_ROOT}/logs/${EXPERIMENT_NAME}.log"
MASTER_PORT=29829
COVERAGE_EPOCHS=2
SAVE_INTERVAL=1
EVAL_INTERVAL=1
EVAL_ITERS=1

