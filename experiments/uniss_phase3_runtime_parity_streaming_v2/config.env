#!/usr/bin/env bash

USER_ROOT="${USER_ROOT:-/opt/dlami/nvme/jasonleeeli}"
REPO_ROOT="${REPO_ROOT:-${USER_ROOT}/projects/UniSS}"
ENV_ROOT="${ENV_ROOT:-${USER_ROOT}/conda_envs/uniss-train}"
PYTHON="${PYTHON:-${ENV_ROOT}/bin/python}"

EXPERIMENT_NAME="${EXPERIMENT_NAME:-uniss_phase3_runtime_parity_streaming_v2}"
PHASE3_NATIVE_CHECKPOINT="${PHASE3_NATIVE_CHECKPOINT:-${REPO_ROOT}/checkpoints/uniss_qwen0p5b_phase3_unist198_after_phase2_v4}"
PHASE3_REPLAY_PACKED="${PHASE3_REPLAY_PACKED:-${REPO_ROOT}/data/megatron/uniss_true_subsecond_pilot15_v1/packed_replay.jsonl}"
VALID_REPLAY_PACKED="${VALID_REPLAY_PACKED:-${REPO_ROOT}/data/megatron/validation_unist_dev/phase3_valid_packed.jsonl}"
VALID_REPLAY_OFFSETS="${VALID_REPLAY_OFFSETS:-${REPO_ROOT}/data/processed/uniss_phase3_true_subsecond_deadline_full198_v1/validation/phase3_valid.u64}"

OVERFIT_ROOT="${OVERFIT_ROOT:-${REPO_ROOT}/data/megatron/${EXPERIMENT_NAME}/overfit1}"
OVERFIT_PACKED="${OVERFIT_PACKED:-${OVERFIT_ROOT}/train.packed.jsonl}"
OVERFIT_TRAINING_ROOT="${OVERFIT_TRAINING_ROOT:-${OVERFIT_ROOT}/training}"
OVERFIT_MANIFEST="${OVERFIT_MANIFEST:-${OVERFIT_TRAINING_ROOT}/training_manifest.json}"
OVERFIT_REPLAY_OFFSETS="${OVERFIT_REPLAY_OFFSETS:-${OVERFIT_TRAINING_ROOT}/replay_subset.u64}"

CANARY_ROOT="${CANARY_ROOT:-${REPO_ROOT}/data/megatron/${EXPERIMENT_NAME}/canary128}"
CANARY_PACKED="${CANARY_PACKED:-${CANARY_ROOT}/train.packed.jsonl}"
CANARY_VALID_PACKED="${CANARY_VALID_PACKED:-${CANARY_ROOT}/valid.packed.jsonl}"

SAVE_DIR="${SAVE_DIR:-${REPO_ROOT}/checkpoints/${EXPERIMENT_NAME}_overfit1_v1}"
RUN_DIR="${RUN_DIR:-${REPO_ROOT}/runs/${EXPERIMENT_NAME}_overfit1_v1}"
TB_DIR="${TB_DIR:-${RUN_DIR}/tensorboard}"
LOG_PATH="${LOG_PATH:-${REPO_ROOT}/logs/${EXPERIMENT_NAME}_overfit1_v1.log}"
TENSORBOARD_PORT="${TENSORBOARD_PORT:-6074}"

CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0,1,2,3,4,5,6,7}"
MASTER_PORT="${MASTER_PORT:-29774}"
MICRO_BATCH_SIZE="${MICRO_BATCH_SIZE:-2}"
GLOBAL_BATCH_SIZE="${GLOBAL_BATCH_SIZE:-128}"
SEQ_LENGTH="${SEQ_LENGTH:-18000}"
COVERAGE_EPOCHS="${COVERAGE_EPOCHS:-100}"
