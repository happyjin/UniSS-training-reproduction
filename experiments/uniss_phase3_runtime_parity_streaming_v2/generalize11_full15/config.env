#!/usr/bin/env bash

USER_ROOT="${USER_ROOT:-/opt/dlami/nvme/jasonleeeli}"
REPO_ROOT="${REPO_ROOT:-${USER_ROOT}/projects/UniSS}"
ENV_ROOT="${ENV_ROOT:-${USER_ROOT}/conda_envs/uniss-train}"
PYTHON="${PYTHON:-${ENV_ROOT}/bin/python}"

EXPERIMENT_NAME="${EXPERIMENT_NAME:-uniss_phase3_runtime_parity_streaming_v2_generalize11_full15_v1}"
PHASE3_NATIVE_CHECKPOINT="${PHASE3_NATIVE_CHECKPOINT:-${REPO_ROOT}/checkpoints/uniss_phase3_dense_aligned_streaming_pilot15_v1}"
PHASE3_REPLAY_PACKED="${PHASE3_REPLAY_PACKED:-${REPO_ROOT}/data/megatron/uniss_true_subsecond_pilot15_v1/packed_replay.jsonl}"
PHASE3_REPLAY_OFFSETS="${PHASE3_REPLAY_OFFSETS:-${REPO_ROOT}/data/megatron/uniss_true_subsecond_pilot15_v1/packed_replay.offsets.u64}"
VALID_REPLAY_PACKED="${VALID_REPLAY_PACKED:-${REPO_ROOT}/data/megatron/validation_unist_dev/phase3_valid_packed.jsonl}"
VALID_REPLAY_OFFSETS="${VALID_REPLAY_OFFSETS:-${REPO_ROOT}/data/processed/uniss_phase3_true_subsecond_deadline_full198_v1/validation/phase3_valid.u64}"
FULL15_ROOT="${FULL15_ROOT:-${REPO_ROOT}/data/megatron/uniss_phase3_dense_aligned_streaming_pilot15_v1}"
TRAJECTORY_PACKED="${TRAJECTORY_PACKED:-${FULL15_ROOT}/packed_dense_train.jsonl}"
VALID_TRAJECTORY_PACKED="${VALID_TRAJECTORY_PACKED:-${FULL15_ROOT}/packed_dense_valid.jsonl}"
TRAINING_ROOT="${TRAINING_ROOT:-${REPO_ROOT}/data/megatron/${EXPERIMENT_NAME}/training}"
TRAINING_MANIFEST="${TRAINING_MANIFEST:-${TRAINING_ROOT}/training_manifest.json}"
REPLAY_SUBSET_OFFSETS="${REPLAY_SUBSET_OFFSETS:-${TRAINING_ROOT}/replay_subset.u64}"
SAVE_DIR="${SAVE_DIR:-${REPO_ROOT}/checkpoints/${EXPERIMENT_NAME}}"
RUN_DIR="${RUN_DIR:-${REPO_ROOT}/runs/${EXPERIMENT_NAME}}"
TB_DIR="${TB_DIR:-${RUN_DIR}/tensorboard}"
LOG_PATH="${LOG_PATH:-${REPO_ROOT}/logs/${EXPERIMENT_NAME}.log}"
TENSORBOARD_PORT="${TENSORBOARD_PORT:-6083}"

CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0,1,2,3,4,5,6,7}"
MASTER_PORT="${MASTER_PORT:-29821}"
MICRO_BATCH_SIZE="${MICRO_BATCH_SIZE:-2}"
GLOBAL_BATCH_SIZE="${GLOBAL_BATCH_SIZE:-128}"
SEQ_LENGTH="${SEQ_LENGTH:-18000}"
COVERAGE_EPOCHS="${COVERAGE_EPOCHS:-1}"
REPLAY_FRACTION="${REPLAY_FRACTION:-0.01}"
LR_QWEN_LORA="${LR_QWEN_LORA:-5e-7}"
LR_FRONTEND="${LR_FRONTEND:-5e-7}"
LR_NEW_HEADS="${LR_NEW_HEADS:-1e-4}"
MIN_LR="${MIN_LR:-1e-5}"
WEIGHT_DECAY="${WEIGHT_DECAY:-0.1}"
SAVE_INTERVAL="${SAVE_INTERVAL:-100}"
EVAL_INTERVAL="${EVAL_INTERVAL:-100}"
EVAL_ITERS="${EVAL_ITERS:-1}"
LOG_INTERVAL="${LOG_INTERVAL:-1}"
NUM_WORKERS="${NUM_WORKERS:-8}"
