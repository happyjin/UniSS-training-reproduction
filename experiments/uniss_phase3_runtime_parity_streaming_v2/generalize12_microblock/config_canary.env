#!/usr/bin/env bash

V12_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "${V12_DIR}/config.env"

EXPERIMENT_NAME="uniss_phase3_runtime_parity_streaming_v2_generalize12_microblock_canary_v1"
TRAJECTORY_PACKED="${REPO_ROOT}/data/megatron/uniss_phase3_runtime_parity_streaming_v2/canary128/train.packed.jsonl"
VALID_TRAJECTORY_PACKED="${REPO_ROOT}/data/megatron/uniss_phase3_runtime_parity_streaming_v2/canary128/valid.packed.jsonl"
TRAINING_ROOT="${REPO_ROOT}/data/megatron/${EXPERIMENT_NAME}/training"
TRAINING_MANIFEST="${TRAINING_ROOT}/training_manifest.json"
REPLAY_SUBSET_OFFSETS="${TRAINING_ROOT}/replay_subset.u64"
SAVE_DIR="${REPO_ROOT}/checkpoints/${EXPERIMENT_NAME}"
RUN_DIR="${REPO_ROOT}/runs/${EXPERIMENT_NAME}"
TB_DIR="${RUN_DIR}/tensorboard"
LOG_PATH="${REPO_ROOT}/logs/${EXPERIMENT_NAME}.log"
TENSORBOARD_PORT=6085
MASTER_PORT=29823
COVERAGE_EPOCHS=200
REPLAY_FRACTION=0.10
LR_NEW_HEADS=2e-4
MIN_LR=1e-5
SAVE_INTERVAL=25
EVAL_INTERVAL=25
SEED=20260820
