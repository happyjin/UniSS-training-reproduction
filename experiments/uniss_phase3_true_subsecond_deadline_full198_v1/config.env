#!/usr/bin/env bash

USER_ROOT="${USER_ROOT:-/opt/dlami/nvme/jasonleeeli}"
REPO_ROOT="${REPO_ROOT:-${USER_ROOT}/projects/UniSS}"
ENV_ROOT="${ENV_ROOT:-${USER_ROOT}/conda_envs/uniss-train}"
PYTHON="${PYTHON:-${ENV_ROOT}/bin/python}"

EXPERIMENT_NAME="${EXPERIMENT_NAME:-uniss_phase3_true_subsecond_deadline_full198_joint_v1}"
EXPERIMENT_DIR="${REPO_ROOT}/experiments/uniss_phase3_true_subsecond_deadline_full198_v1"
