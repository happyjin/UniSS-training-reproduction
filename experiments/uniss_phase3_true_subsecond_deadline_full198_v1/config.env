WHISPERVQ_CODEBOOK="${WHISPERVQ_CODEBOOK:-${SPEECH_TOKENIZER}/glm4_tokenizer/model.safetensors}"

DATA_ROOT="${DATA_ROOT:-${REPO_ROOT}/data/processed/uniss_phase3_true_subsecond_deadline_full198_v1}"
INDEX_ROOT="${INDEX_ROOT:-${DATA_ROOT}/direction_index}"
TRAJECTORY_ROOT="${TRAJECTORY_ROOT:-${DATA_ROOT}/trajectory_plan}"
CACHE_ROOT="${CACHE_ROOT:-${DATA_ROOT}/trajectory_cache}"
PACKED_ROOT="${PACKED_ROOT:-${REPO_ROOT}/data/megatron/uniss_true_subsecond_full198}"
TRAJECTORY_PACKED="${TRAJECTORY_PACKED:-${PACKED_ROOT}/packed_trajectory.jsonl}"
TRAJECTORY_OFFSETS="${TRAJECTORY_OFFSETS:-${PACKED_ROOT}/packed_trajectory.offsets.u64}"
PHASE3_REPLAY_PACKED="${PHASE3_REPLAY_PACKED:-${REPO_ROOT}/data/megatron/phase3_unist198/packed_train.jsonl}"
PHASE3_REPLAY_OFFSETS="${PHASE3_REPLAY_OFFSETS:-${REPO_ROOT}/data/processed/phase3_whisper_streamspeech_joint_v1/phase3_replay_index/full198.u64}"
VALID_REPLAY_PACKED="${VALID_REPLAY_PACKED:-${REPO_ROOT}/data/megatron/validation_unist_dev/phase3_valid_packed.jsonl}"
VALID_REPLAY_OFFSETS="${VALID_REPLAY_OFFSETS:-${DATA_ROOT}/validation/phase3_valid.u64}"
PHASE3_FINGERPRINT="${PHASE3_FINGERPRINT:-${DATA_ROOT}/model_handoff/phase3_embedding_fingerprint.json}"

SAVE_DIR="${SAVE_DIR:-${REPO_ROOT}/checkpoints/${EXPERIMENT_NAME}}"
RUN_DIR="${RUN_DIR:-${REPO_ROOT}/runs/${EXPERIMENT_NAME}}"
TB_DIR="${TB_DIR:-${RUN_DIR}/tensorboard}"
LOG_PATH="${LOG_PATH:-${REPO_ROOT}/logs/${EXPERIMENT_NAME}.log}"
REPORT_DIR="${REPORT_DIR:-${REPO_ROOT}/reports/uniss_phase3_true_subsecond_deadline_full198_v1}"

CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0,1,2,3,4,5,6,7}"
NPROC_PER_NODE="${NPROC_PER_NODE:-8}"
MASTER_PORT="${MASTER_PORT:-29710}"
TENSORBOARD_PORT="${TENSORBOARD_PORT:-6070}"

MICRO_BATCH_SIZE="${MICRO_BATCH_SIZE:-2}"
GLOBAL_BATCH_SIZE="${GLOBAL_BATCH_SIZE:-128}"
SEQ_LENGTH="${SEQ_LENGTH:-18000}"
LR_QWEN_LORA="${LR_QWEN_LORA:-1e-5}"
LR_FRONTEND="${LR_FRONTEND:-5e-6}"
LR_NEW_HEADS="${LR_NEW_HEADS:-5e-5}"
MIN_LR="${MIN_LR:-1e-6}"
WEIGHT_DECAY="${WEIGHT_DECAY:-0.1}"
SAVE_INTERVAL="${SAVE_INTERVAL:-100}"
EVAL_INTERVAL="${EVAL_INTERVAL:-100}"
EVAL_ITERS="${EVAL_ITERS:-10}"
LOG_INTERVAL="${LOG_INTERVAL:-10}"
NUM_WORKERS="${NUM_WORKERS:-8}"
NPZ_LRU_CAPACITY="${NPZ_LRU_CAPACITY:-8}"
PREPROCESS_WORKERS="${PREPROCESS_WORKERS:-32}"
PACK_WORKERS="${PACK_WORKERS:-8}"
SEED="${SEED:-20260810}"
