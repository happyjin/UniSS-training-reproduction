# Isolated full free-running Stage7A test evaluation: four experiments x 2 GPU.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "${SCRIPT_DIR}/../experiment.env"

EVAL_ENV="${EVAL_ENV:-${USER_ROOT}/conda_envs/uniss-eval}"
SPEECH_TOKENIZER="${SPEECH_TOKENIZER:-${REPO_ROOT}/pretrained_models/UniSS}"
OFFLINE_PHASE3_TEST="${OFFLINE_PHASE3_TEST:-${REPO_ROOT}/eval_outputs/qwen0p5b_phase3_unist198_iter_0009075_unist_test_full_20260726T065924Z}"
EXPECTED_TEST_RECORDS="${EXPECTED_TEST_RECORDS:-23369}"

TEST_EVAL_NAME="${TEST_EVAL_NAME:-simul_uniss_stage7a_15shard_v1_full_test_e2e_v1}"
TEST_EVAL_ROOT="${TEST_EVAL_ROOT:-${EVAL_ROOT}/full_test_e2e_v1}"
FULL_RUN_ID="${FULL_RUN_ID:-full_test_v1}"

E0_MODEL="${E0_MODEL:-${STAGE6_MODEL}}"
E1_MODEL="${E1_MODEL:-${EXPORT_ROOT}/e1_continued_sft_best_hf}"
E2_MODEL="${E2_MODEL:-${EXPORT_ROOT}/e2_grpo_g4_best_hf}"
E3_MODEL="${E3_MODEL:-${EXPORT_ROOT}/e3_grpo_g8_best_hf}"

E0_TEST_GPUS="${E0_TEST_GPUS:-0,1}"
E1_TEST_GPUS="${E1_TEST_GPUS:-2,3}"
E2_TEST_GPUS="${E2_TEST_GPUS:-4,5}"
E3_TEST_GPUS="${E3_TEST_GPUS:-6,7}"

# H200 throughput settings.  Each rank receives up to 1,024 simultaneous
# utterances.  This doubles the previous Stage6 evaluation concurrency while
# preserving the exact greedy decode and per-utterance causal isolation.
BATCH_RECORDS="${BATCH_RECORDS:-1024}"
MAX_WRITE_TOKENS="${MAX_WRITE_TOKENS:-700}"
REPETITION_PENALTY="${REPETITION_PENALTY:-1.1}"
MAX_MODEL_LEN="${MAX_MODEL_LEN:-32768}"
TRAINING_CONTEXT_LIMIT="${TRAINING_CONTEXT_LIMIT:-18000}"
MAX_NUM_SEQS="${MAX_NUM_SEQS:-1024}"
MAX_NUM_BATCHED_TOKENS="${MAX_NUM_BATCHED_TOKENS:-524288}"
MAX_SEQ_LEN_TO_CAPTURE="${MAX_SEQ_LEN_TO_CAPTURE:-2048}"
GPU_MEMORY_UTILIZATION="${GPU_MEMORY_UTILIZATION:-0.94}"

DECODE_BATCH_SIZE="${DECODE_BATCH_SIZE:-32}"
LEFT_CONTEXT_TOKENS="${LEFT_CONTEXT_TOKENS:-50}"
HOLDBACK_TOKENS="${HOLDBACK_TOKENS:-5}"
OVERLAP_MS="${OVERLAP_MS:-80}"

ASR_BATCH_SIZE="${ASR_BATCH_SIZE:-32}"
AUTOPCP_BATCH_SIZE="${AUTOPCP_BATCH_SIZE:-32}"
AUTOPCP_CHUNK_SIZE="${AUTOPCP_CHUNK_SIZE:-1024}"
LATENCY_RECORDS="${LATENCY_RECORDS:-200}"
SMOKE_RECORDS="${SMOKE_RECORDS:-16}"
