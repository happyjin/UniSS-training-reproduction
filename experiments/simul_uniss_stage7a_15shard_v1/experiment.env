# Isolated Stage7A action-only experiments initialized from Stage6 iteration 1189.

USER_ROOT="${USER_ROOT:-/opt/dlami/nvme/jasonleeeli}"
REPO_ROOT="${REPO_ROOT:-${USER_ROOT}/projects/UniSS}"
TRAIN_ENV="${TRAIN_ENV:-${USER_ROOT}/conda_envs/uniss-train}"

EXPERIMENT_NAME="${EXPERIMENT_NAME:-simul_uniss_stage7a_15shard_v1}"
STAGE6_MODEL="${STAGE6_MODEL:-${REPO_ROOT}/checkpoints/exported_hf/simul_uniss_stage6_streaming_v1_iter_0001189_hf}"
TRAIN_SAMPLES="${TRAIN_SAMPLES:-${REPO_ROOT}/data/processed/simul_uniss_v1/bootstrap_15shard/action_samples.jsonl}"
DEV_SAMPLES="${DEV_SAMPLES:-${REPO_ROOT}/data/processed/simul_uniss_v1/validation_dev/action_samples.jsonl}"
DEV_SCHEDULES="${DEV_SCHEDULES:-${REPO_ROOT}/data/processed/simul_uniss_v1/validation_dev/schedules.jsonl}"
TEST_SAMPLES="${TEST_SAMPLES:-${REPO_ROOT}/data/processed/simul_uniss_v1/evaluation_test/samples.jsonl}"
TEST_SCHEDULES="${TEST_SCHEDULES:-${REPO_ROOT}/data/processed/simul_uniss_v1/evaluation_test/schedules.jsonl}"

CHECKPOINT_ROOT="${CHECKPOINT_ROOT:-${REPO_ROOT}/checkpoints/${EXPERIMENT_NAME}}"
RUN_ROOT="${RUN_ROOT:-${REPO_ROOT}/runs/${EXPERIMENT_NAME}}"
LOG_ROOT="${LOG_ROOT:-${REPO_ROOT}/logs/${EXPERIMENT_NAME}}"
EVAL_ROOT="${EVAL_ROOT:-${REPO_ROOT}/eval_outputs/${EXPERIMENT_NAME}}"
EXPORT_ROOT="${EXPORT_ROOT:-${REPO_ROOT}/checkpoints/exported_hf/${EXPERIMENT_NAME}}"

E0_GPUS="${E0_GPUS:-0,1}"
E1_GPUS="${E1_GPUS:-2,3}"
E2_GPUS="${E2_GPUS:-4,5}"
E3_GPUS="${E3_GPUS:-6,7}"
E0_MASTER_PORT="${E0_MASTER_PORT:-30470}"
E1_MASTER_PORT="${E1_MASTER_PORT:-30471}"
E2_MASTER_PORT="${E2_MASTER_PORT:-30472}"
E3_MASTER_PORT="${E3_MASTER_PORT:-30473}"

TRAIN_STEPS="${TRAIN_STEPS:-1000}"
SFT_WARMUP_STEPS="${SFT_WARMUP_STEPS:-100}"
LEARNING_RATE="${LEARNING_RATE:-3e-5}"
WEIGHT_DECAY="${WEIGHT_DECAY:-0.01}"
LR_WARMUP_STEPS="${LR_WARMUP_STEPS:-50}"
KL_BETA="${KL_BETA:-0.02}"
SFT_REPLAY_WEIGHT="${SFT_REPLAY_WEIGHT:-0.2}"
MAX_SEQUENCE_LENGTH="${MAX_SEQUENCE_LENGTH:-18000}"

# Individual sequences are short. Increase total tokens per dynamic batch rather
# than padding every sample to the old Megatron 13k/18k sequence length.
# H200 profile (2026-07-27): 524k padded tokens/rank sustains 100% GPU
# utilization at roughly 631-686 W with about 38-40 GiB resident memory.  The
# old Megatron 13k/18k fixed length is not useful here because each action
# sample is short; dynamic token batching preserves the same 18k safety cap.
MAX_BATCH_TOKENS_PER_GPU="${MAX_BATCH_TOKENS_PER_GPU:-524288}"
MAX_BATCH_SIZE_PER_GPU="${MAX_BATCH_SIZE_PER_GPU:-1024}"
EVAL_MAX_BATCH_TOKENS_PER_GPU="${EVAL_MAX_BATCH_TOKENS_PER_GPU:-524288}"
EVAL_MAX_BATCH_SIZE_PER_GPU="${EVAL_MAX_BATCH_SIZE_PER_GPU:-1024}"
SHUFFLE_BUFFER_SIZE="${SHUFFLE_BUFFER_SIZE:-8192}"
VALIDATION_RECORDS="${VALIDATION_RECORDS:-512}"
LOG_INTERVAL="${LOG_INTERVAL:-10}"
EVAL_INTERVAL="${EVAL_INTERVAL:-100}"
SAVE_INTERVAL="${SAVE_INTERVAL:-100}"
BASE_SEED="${BASE_SEED:-20260727}"

TENSORBOARD_PORT="${TENSORBOARD_PORT:-6030}"
TENSORBOARD_SESSION="${TENSORBOARD_SESSION:-simul_uniss_stage7a_tensorboard}"
