#!/usr/bin/env bash

FULL198_EXPERIMENT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
V6_EXPERIMENT_ROOT="$(cd "${FULL198_EXPERIMENT_ROOT}/.." && pwd)"

_FULL198_REQUESTED_CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-}"
_FULL198_REQUESTED_NPROC_PER_NODE="${NPROC_PER_NODE:-}"
_FULL198_REQUESTED_MASTER_PORT="${MASTER_PORT:-}"
_FULL198_REQUESTED_MICRO_BATCH_SIZE="${MICRO_BATCH_SIZE:-}"
_FULL198_REQUESTED_GLOBAL_BATCH_SIZE="${GLOBAL_BATCH_SIZE:-}"
_FULL198_REQUESTED_NUM_WORKERS="${NUM_WORKERS:-}"

# shellcheck source=/dev/null
source "${V6_EXPERIMENT_ROOT}/experiment.env"

FULL198_DATA_ROOT="${FULL198_DATA_ROOT:-${REPO_ROOT}/data/processed/phase3_whisper_streamspeech_joint_v1/full198_joint}"
FULL198_REPLAY_OFFSETS="${FULL198_REPLAY_OFFSETS:-${REPO_ROOT}/data/processed/phase3_whisper_streamspeech_joint_v1/phase3_replay_index/full198.u64}"

CUDA_VISIBLE_DEVICES="${_FULL198_REQUESTED_CUDA_VISIBLE_DEVICES:-0,1,2,3,4,5,6,7}"
NPROC_PER_NODE="${_FULL198_REQUESTED_NPROC_PER_NODE:-8}"
MASTER_PORT="${_FULL198_REQUESTED_MASTER_PORT:-29785}"
MICRO_BATCH_SIZE="${_FULL198_REQUESTED_MICRO_BATCH_SIZE:-2}"
GLOBAL_BATCH_SIZE="${_FULL198_REQUESTED_GLOBAL_BATCH_SIZE:-128}"
NUM_WORKERS="${_FULL198_REQUESTED_NUM_WORKERS:-16}"

unset _FULL198_REQUESTED_CUDA_VISIBLE_DEVICES _FULL198_REQUESTED_NPROC_PER_NODE
unset _FULL198_REQUESTED_MASTER_PORT _FULL198_REQUESTED_MICRO_BATCH_SIZE
unset _FULL198_REQUESTED_GLOBAL_BATCH_SIZE _FULL198_REQUESTED_NUM_WORKERS

STAGE_A_RUN_NAME="${STAGE_A_RUN_NAME:-phase3_joint_v6_stage_a_heads_only_full198_v1}"
STAGE_B_RUN_NAME="${STAGE_B_RUN_NAME:-phase3_joint_v6_stage_b_guarded_joint_full198_v2_mbs1}"
STAGE_A_MICRO_BATCH_SIZE="${STAGE_A_MICRO_BATCH_SIZE:-2}"
STAGE_B_MICRO_BATCH_SIZE="${STAGE_B_MICRO_BATCH_SIZE:-1}"
PIPELINE_SESSION="${PIPELINE_SESSION:-uniss_phase3_joint_v6_full198}"
STAGE_B_SESSION="${STAGE_B_SESSION:-uniss_phase3_joint_v6_full198_stage_b_v2}"

FULL198_STATUS_ROOT="${FULL198_STATUS_ROOT:-${REPO_ROOT}/logs/uniss_phase3_whisper_streamspeech_joint_v6/full198_pipeline_v1}"
