#!/usr/bin/env bash

# Isolated full-198 Stage A experiment. Do not write into the pilot15 trees.

EXPERIMENT_NAME="uniss_phase3_v4_quality_first_true_streaming_full198_v1"
USER_ROOT="/opt/dlami/nvme/neuhao"
REPO_ROOT="${USER_ROOT}/UniSS"
PYTHON_BIN="${USER_ROOT}/conda_envs/uniss-train/bin/python"

PHASE3_NATIVE_ROOT="${REPO_ROOT}/checkpoints/uniss_qwen0p5b_phase3_unist198_after_phase2_v4"
PHASE3_NATIVE_CHECKPOINT="${PHASE3_NATIVE_ROOT}/iter_0009075"
PHASE3_HF_CHECKPOINT="${REPO_ROOT}/checkpoints/exported_hf/qwen0p5b_phase3_unist198_iter_0009075_hf"
WHISPERVQ_CHECKPOINT="${REPO_ROOT}/pretrained_models/UniSS/glm4_tokenizer"

PILOT15_STAGE_A_ROOT="${REPO_ROOT}/data/processed/simul_uniss_subsecond_v2/formal_15shard_v1/stage_a_formal"
STAGE_A_FORMAL_ROOT="${REPO_ROOT}/data/processed/${EXPERIMENT_NAME}/stage_a_source"
STAGE_A_SOURCE_TRAIN="${STAGE_A_FORMAL_ROOT}/formal_train_manifest.jsonl"
STAGE_A_SOURCE_VALID="${STAGE_A_FORMAL_ROOT}/formal_valid_manifest.jsonl"

DATA_ROOT="${REPO_ROOT}/data/processed/${EXPERIMENT_NAME}"
PILOT15_VALID_MANIFEST="${DATA_ROOT}/stage00_refs/formal_valid_manifest.neuhao.jsonl"
MEGATRON_DATA_ROOT="${REPO_ROOT}/data/megatron/${EXPERIMENT_NAME}"
CHECKPOINT_ROOT="${REPO_ROOT}/checkpoints/${EXPERIMENT_NAME}"
RUN_ROOT="${REPO_ROOT}/runs/${EXPERIMENT_NAME}"
LOG_ROOT="${REPO_ROOT}/logs/${EXPERIMENT_NAME}"
REPORT_ROOT="${REPO_ROOT}/reports/${EXPERIMENT_NAME}"
EVAL_ROOT="${REPO_ROOT}/eval_outputs/${EXPERIMENT_NAME}"

STAGE_A_DATA_ROOT="${DATA_ROOT}/stage_a_causal_asr"
STAGE_A_REFERENCE_CTC_MAP_ROOT="${REPO_ROOT}/data/processed/uniss_phase3_v4_quality_first_true_streaming_pilot15_v1/stage_a_causal_asr/ctc_maps_utf8_byte_v5"
STAGE_A_CTC_MAP_ROOT="${STAGE_A_DATA_ROOT}/ctc_maps_utf8_byte_v5"
STAGE_A_MAX_TRAIN_SHARD="${STAGE_A_MAX_TRAIN_SHARD:-197}"
STAGE_A_CTC_MAP_REPORT="${STAGE_A_CTC_MAP_ROOT}/ctc_map_build_report.json"
STAGE_A_SOURCE_SNAPSHOT="${STAGE_A_DATA_ROOT}/source_snapshot_v1.json"
STAGE_A_PACK_ROOT="${MEGATRON_DATA_ROOT}/stage_a_causal_asr"
STAGE_A_TRAIN_PACKS="${STAGE_A_PACK_ROOT}/train_packs_18k_v1.jsonl"
STAGE_A_VALID_PACKS="${STAGE_A_PACK_ROOT}/valid_packs_18k_v1.jsonl"
STAGE_A_FORMAL_PCM_GLM_GATE="${REPORT_ROOT}/stage_a_causal_whisper_asr/STAGE_A_FORMAL_PCM_GLM_GEOMETRY_GATE_PASSED.json"
STAGE_A_TRAINING_GATE="${REPORT_ROOT}/stage_a_causal_whisper_asr/STAGE_A_TRAINING_GATE_PASSED.json"
STAGE_A_FRONTEND_TRAINING_GATE="${REPORT_ROOT}/stage_a_causal_whisper_asr/frontend_parity/latest/FRONTEND_TRAINING_GATE_PASSED.json"
STAGE_A_SMOKE_PACK_ROOT="${STAGE_A_DATA_ROOT}/pack_smoke_latest"
STAGE_A_PHASE3_FINGERPRINT="${DATA_ROOT}/model_handoff/phase3_embedding_fingerprint.json"

export HF_HOME="${USER_ROOT}/cache/huggingface"
export TRANSFORMERS_CACHE="${HF_HOME}/hub"
export TORCH_HOME="${USER_ROOT}/cache/torch"
export TRITON_CACHE_DIR="${USER_ROOT}/cache/triton"
export XDG_CACHE_HOME="${USER_ROOT}/cache"
export TMPDIR="${USER_ROOT}/tmp"
