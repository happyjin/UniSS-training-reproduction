# Isolated long-context Stage4/Stage6 continuation after the v7 Stage3 run.
# Existing experiments, data, checkpoints, logs, and TensorBoard roots remain read-only.

USER_ROOT="${USER_ROOT:-/opt/dlami/nvme/jasonleeeli}"
ACTIVATE_SCRIPT="${ACTIVATE_SCRIPT:-${USER_ROOT}/env_recovery/uniss-train-20260721/activate_uniss.sh}"
SIMUL_EXPERIMENT="${SIMUL_EXPERIMENT:-simul_uniss_v8_full198_seq18000_mbs2_gbs128_stage4_stage6}"

SEQ_LENGTH="${SEQ_LENGTH:-18000}"
SHARD_START="${SHARD_START:-0}"
SHARD_COUNT="${SHARD_COUNT:-198}"
PACK_WORKERS="${PACK_WORKERS:-8}"

# Reuse immutable v3 prepared samples, but publish all 18k interleaved artifacts
# into this experiment's own namespace.
SOURCE_PREPARED_PARTS_DIR="${SOURCE_PREPARED_PARTS_DIR:-${REPO_ROOT}/data/processed/simul_uniss_v3_full198/parts}"
PACKED_DIR="${PACKED_DIR:-${REPO_ROOT}/data/megatron/${SIMUL_EXPERIMENT}}"
PACKED_PARTS_DIR="${PACKED_PARTS_DIR:-${PACKED_DIR}/parts}"
PACKED_TRAIN="${PACKED_TRAIN:-${PACKED_DIR}/packed_interleaved_train.jsonl}"
DATA_ASSEMBLY_MARKER="${DATA_ASSEMBLY_MARKER:-${PACKED_DIR}/INTERLEAVED_DATA_COMPLETE.json}"
TRAINING_SCHEDULE_FILE="${TRAINING_SCHEDULE_FILE:-${PACKED_DIR}/training_schedule.env}"
FULL_DATA_READY_MARKER="${FULL_DATA_READY_MARKER:-${PACKED_DIR}/FULL_DATA_READY.json}"

VALID_SOURCE_SAMPLES="${VALID_SOURCE_SAMPLES:-${REPO_ROOT}/data/processed/simul_uniss_v1/validation_dev/samples.jsonl}"
VALID_PACKED_DIR="${VALID_PACKED_DIR:-${PACKED_DIR}/validation_dev}"
VALID_PACKED_INTERLEAVED="${VALID_PACKED_INTERLEAVED:-${VALID_PACKED_DIR}/packed_interleaved_valid.jsonl}"
VALID_INTERLEAVED_MARKER="${VALID_INTERLEAVED_MARKER:-${VALID_PACKED_DIR}/PACK_INTERLEAVED_COMPLETE.json}"

RUN_DIR="${RUN_DIR:-${REPO_ROOT}/runs/${SIMUL_EXPERIMENT}}"
TENSORBOARD_DIR="${TENSORBOARD_DIR:-${RUN_DIR}/tensorboard}"
LOG_DIR="${LOG_DIR:-${REPO_ROOT}/logs/${SIMUL_EXPERIMENT}}"
SIMUL_CHECKPOINT_ROOT="${SIMUL_CHECKPOINT_ROOT:-${REPO_ROOT}/checkpoints/${SIMUL_EXPERIMENT}}"

V7_STAGE3_EXPERIMENT="${V7_STAGE3_EXPERIMENT:-simul_uniss_v7_full198_seq18000_mbs2_gbs128_stage3}"
V7_STAGE3_ROOT="${V7_STAGE3_ROOT:-${REPO_ROOT}/checkpoints/${V7_STAGE3_EXPERIMENT}/stage03_action_sft}"
V7_STAGE3_REQUIRED_ITERATION="${V7_STAGE3_REQUIRED_ITERATION:-4753}"

TENSORBOARD_PORT="${TENSORBOARD_PORT:-6022}"
TENSORBOARD_SESSION="${TENSORBOARD_SESSION:-simul_uniss_v8_seq18000_stage4_stage6_tensorboard}"

SIMUL_CUDA_VISIBLE_DEVICES="${SIMUL_CUDA_VISIBLE_DEVICES:-0,1,2,3,4,5,6,7}"
SIMUL_NPROC_PER_NODE="${SIMUL_NPROC_PER_NODE:-8}"
SIMUL_MICRO_BATCH_SIZE="${SIMUL_MICRO_BATCH_SIZE:-2}"
SIMUL_GLOBAL_BATCH_SIZE="${SIMUL_GLOBAL_BATCH_SIZE:-128}"
SIMUL_DATALOADER_TYPE="${SIMUL_DATALOADER_TYPE:-cyclic}"
SIMUL_NO_DATA_SHARDING="${SIMUL_NO_DATA_SHARDING:-1}"
SIMUL_FULL_VALIDATION="${SIMUL_FULL_VALIDATION:-1}"
SIMUL_DATA_SEED="${SIMUL_DATA_SEED:-20260726}"
SIMUL_OFFSET_INDEX_MODE="${SIMUL_OFFSET_INDEX_MODE:-sidecar}"

# Each stage starts a fresh optimizer/scheduler/RNG state from the preceding
# stage's model weights. It never resumes optimizer state across stage boundaries.
SIMUL_NO_LOAD_OPTIM="${SIMUL_NO_LOAD_OPTIM:-1}"
SIMUL_NO_LOAD_RNG="${SIMUL_NO_LOAD_RNG:-1}"
SIMUL_FINETUNE="${SIMUL_FINETUNE:-1}"

SIMUL_QWEN_LR="${SIMUL_QWEN_LR:-1e-5}"
SIMUL_QWEN_MIN_LR="${SIMUL_QWEN_MIN_LR:-1e-6}"
SIMUL_QWEN_SAVE_INTERVAL="${SIMUL_QWEN_SAVE_INTERVAL:-500}"
SIMUL_QWEN_EVAL_INTERVAL="${SIMUL_QWEN_EVAL_INTERVAL:-500}"
SIMUL_QWEN_EVAL_ITERS="${SIMUL_QWEN_EVAL_ITERS:-1}"
SIMUL_QWEN_LOG_INTERVAL="${SIMUL_QWEN_LOG_INTERVAL:-10}"
SIMUL_QWEN_TENSORBOARD_LOG_INTERVAL="${SIMUL_QWEN_TENSORBOARD_LOG_INTERVAL:-10}"
SIMUL_QWEN_TENSORBOARD_MEMORY_INTERVAL="${SIMUL_QWEN_TENSORBOARD_MEMORY_INTERVAL:-10}"

FULL_STAGE4_EPOCHS="${FULL_STAGE4_EPOCHS:-1.0}"
FULL_STAGE6_EPOCHS="${FULL_STAGE6_EPOCHS:-0.25}"
FULL_WARMUP_FRACTION="${FULL_WARMUP_FRACTION:-0.05}"

STAGE4_LOAD_ROOT="${STAGE4_LOAD_ROOT:-${V7_STAGE3_ROOT}}"
STAGE4_SAVE_ROOT="${STAGE4_SAVE_ROOT:-${SIMUL_CHECKPOINT_ROOT}/stage04_interleaved_s2st}"
STAGE4_TENSORBOARD_DIR="${STAGE4_TENSORBOARD_DIR:-${TENSORBOARD_DIR}/stage04_interleaved_s2st}"
STAGE4_MASTER_PORT="${STAGE4_MASTER_PORT:-30034}"

STAGE6_LOAD_ROOT="${STAGE6_LOAD_ROOT:-${STAGE4_SAVE_ROOT}}"
STAGE6_SAVE_ROOT="${STAGE6_SAVE_ROOT:-${SIMUL_CHECKPOINT_ROOT}/stage06_joint_refinement}"
STAGE6_TENSORBOARD_DIR="${STAGE6_TENSORBOARD_DIR:-${TENSORBOARD_DIR}/stage06_joint_refinement}"
STAGE6_MASTER_PORT="${STAGE6_MASTER_PORT:-30036}"
STAGE6_QWEN_LR="${STAGE6_QWEN_LR:-3e-6}"
STAGE6_QWEN_MIN_LR="${STAGE6_QWEN_MIN_LR:-5e-7}"

if [[ -f "${TRAINING_SCHEDULE_FILE}" ]]; then
  # shellcheck source=/dev/null
  source "${TRAINING_SCHEDULE_FILE}"
fi
