# Isolated full198 restart with the non-simultaneous Phase3 batch geometry.
# Training data and the Phase3 anchor are reused read-only; every output path is new.

USER_ROOT="${USER_ROOT:-/opt/dlami/nvme/jasonleeeli}"
ACTIVATE_SCRIPT="${ACTIVATE_SCRIPT:-${USER_ROOT}/env_recovery/uniss-train-20260721/activate_uniss.sh}"

SIMUL_EXPERIMENT="${SIMUL_EXPERIMENT:-simul_uniss_v4_full198_gbs128}"
SOURCE_FULL_EXPERIMENT="${SOURCE_FULL_EXPERIMENT:-simul_uniss_v3_full198}"
SOURCE_PROCESSED_DIR="${SOURCE_PROCESSED_DIR:-${REPO_ROOT}/data/processed/${SOURCE_FULL_EXPERIMENT}}"
SOURCE_PACKED_DIR="${SOURCE_PACKED_DIR:-${REPO_ROOT}/data/megatron/${SOURCE_FULL_EXPERIMENT}}"
SCHEDULES_JSONL="${SCHEDULES_JSONL:-${SOURCE_PROCESSED_DIR}/schedules.jsonl}"
PACKED_TRAIN="${PACKED_TRAIN:-${SOURCE_PACKED_DIR}/packed_interleaved_train.jsonl}"
ACTION_PACKED_TRAIN="${ACTION_PACKED_TRAIN:-${SOURCE_PACKED_DIR}/packed_action_train.jsonl}"
DATA_ASSEMBLY_MARKER="${DATA_ASSEMBLY_MARKER:-${SOURCE_PACKED_DIR}/DATA_ASSEMBLY_COMPLETE.json}"
FULL_DATA_READY_MARKER="${FULL_DATA_READY_MARKER:-${SOURCE_PACKED_DIR}/FULL_DATA_READY.json}"

SEQ_LENGTH="${SEQ_LENGTH:-4096}"
RUN_DIR="${RUN_DIR:-${REPO_ROOT}/runs/${SIMUL_EXPERIMENT}}"
TENSORBOARD_DIR="${TENSORBOARD_DIR:-${RUN_DIR}/tensorboard}"
LOG_DIR="${LOG_DIR:-${REPO_ROOT}/logs/${SIMUL_EXPERIMENT}}"
SIMUL_CHECKPOINT_ROOT="${SIMUL_CHECKPOINT_ROOT:-${REPO_ROOT}/checkpoints/${SIMUL_EXPERIMENT}}"
TRAINING_SCHEDULE_FILE="${TRAINING_SCHEDULE_FILE:-${REPO_ROOT}/data/megatron/${SIMUL_EXPERIMENT}/training_schedule.env}"

# Restart Stage 3 from the completed non-simultaneous Phase3 checkpoint, not
# from the stopped v3 streaming checkpoint. This is a clean GBS=128 experiment.
QWEN_CHECKPOINT_ROOT="${QWEN_CHECKPOINT_ROOT:-${REPO_ROOT}/checkpoints/uniss_qwen0p5b_phase3_unist198_after_phase2_v4}"
VALID_PACKED_DIR="${VALID_PACKED_DIR:-${REPO_ROOT}/data/megatron/simul_uniss_v1/validation_dev}"
VALID_PACKED_INTERLEAVED="${VALID_PACKED_INTERLEAVED:-${VALID_PACKED_DIR}/packed_interleaved_valid.jsonl}"
VALID_PACKED_ACTION="${VALID_PACKED_ACTION:-${VALID_PACKED_DIR}/packed_action_valid.jsonl}"

TENSORBOARD_PORT="${TENSORBOARD_PORT:-6018}"
TENSORBOARD_SESSION="${TENSORBOARD_SESSION:-simul_uniss_v4_full198_gbs128_tensorboard}"

SIMUL_CUDA_VISIBLE_DEVICES="${SIMUL_CUDA_VISIBLE_DEVICES:-0,1,2,3,4,5,6,7}"
SIMUL_NPROC_PER_NODE="${SIMUL_NPROC_PER_NODE:-8}"
SIMUL_MICRO_BATCH_SIZE="${SIMUL_MICRO_BATCH_SIZE:-2}"
SIMUL_GLOBAL_BATCH_SIZE="${SIMUL_GLOBAL_BATCH_SIZE:-128}"
SIMUL_DATALOADER_TYPE="${SIMUL_DATALOADER_TYPE:-cyclic}"
SIMUL_NO_DATA_SHARDING="${SIMUL_NO_DATA_SHARDING:-1}"
SIMUL_FULL_VALIDATION="${SIMUL_FULL_VALIDATION:-1}"
SIMUL_DATA_SEED="${SIMUL_DATA_SEED:-20260729}"
SIMUL_QWEN_LR="${SIMUL_QWEN_LR:-1e-5}"
SIMUL_QWEN_MIN_LR="${SIMUL_QWEN_MIN_LR:-1e-6}"
SIMUL_QWEN_SAVE_INTERVAL="${SIMUL_QWEN_SAVE_INTERVAL:-500}"
SIMUL_QWEN_EVAL_INTERVAL="${SIMUL_QWEN_EVAL_INTERVAL:-500}"
SIMUL_QWEN_EVAL_ITERS="${SIMUL_QWEN_EVAL_ITERS:-1}"

FULL_STAGE3_EPOCHS="${FULL_STAGE3_EPOCHS:-1.0}"
FULL_STAGE4_EPOCHS="${FULL_STAGE4_EPOCHS:-1.0}"
FULL_STAGE6_EPOCHS="${FULL_STAGE6_EPOCHS:-0.25}"
FULL_WARMUP_FRACTION="${FULL_WARMUP_FRACTION:-0.05}"

STAGE3_LOAD_ROOT="${STAGE3_LOAD_ROOT:-${QWEN_CHECKPOINT_ROOT}}"
STAGE3_SAVE_ROOT="${STAGE3_SAVE_ROOT:-${SIMUL_CHECKPOINT_ROOT}/stage03_action_sft}"
STAGE3_TENSORBOARD_DIR="${STAGE3_TENSORBOARD_DIR:-${TENSORBOARD_DIR}/stage03_action_sft}"
STAGE3_MASTER_PORT="${STAGE3_MASTER_PORT:-29931}"

STAGE4_LOAD_ROOT="${STAGE4_LOAD_ROOT:-${STAGE3_SAVE_ROOT}}"
STAGE4_SAVE_ROOT="${STAGE4_SAVE_ROOT:-${SIMUL_CHECKPOINT_ROOT}/stage04_interleaved_s2st}"
STAGE4_TENSORBOARD_DIR="${STAGE4_TENSORBOARD_DIR:-${TENSORBOARD_DIR}/stage04_interleaved_s2st}"
STAGE4_MASTER_PORT="${STAGE4_MASTER_PORT:-29932}"

STAGE6_LOAD_ROOT="${STAGE6_LOAD_ROOT:-${STAGE4_SAVE_ROOT}}"
STAGE6_SAVE_ROOT="${STAGE6_SAVE_ROOT:-${SIMUL_CHECKPOINT_ROOT}/stage06_joint_refinement}"
STAGE6_TENSORBOARD_DIR="${STAGE6_TENSORBOARD_DIR:-${TENSORBOARD_DIR}/stage06_joint_refinement}"
STAGE6_MASTER_PORT="${STAGE6_MASTER_PORT:-29933}"
STAGE6_QWEN_LR="${STAGE6_QWEN_LR:-3e-6}"
STAGE6_QWEN_MIN_LR="${STAGE6_QWEN_MIN_LR:-5e-7}"

if [[ -f "${TRAINING_SCHEDULE_FILE}" ]]; then
  # shellcheck source=/dev/null
  source "${TRAINING_SCHEDULE_FILE}"
fi
