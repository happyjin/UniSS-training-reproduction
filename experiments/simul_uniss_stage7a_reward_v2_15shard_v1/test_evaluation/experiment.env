# Frozen full-test evaluation for the four Reward-v2 operating points selected on dev.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "${SCRIPT_DIR}/../experiment.env"

TEST_SCHEDULES="${TEST_SCHEDULES:-${REPO_ROOT}/data/processed/simul_uniss_v1/evaluation_test/schedules.jsonl}"
EXPECTED_TEST_RECORDS="${EXPECTED_TEST_RECORDS:-23369}"
OFFLINE_PHASE3_TEST="${OFFLINE_PHASE3_TEST:-${REPO_ROOT}/eval_outputs/qwen0p5b_phase3_unist198_iter_0009075_unist_test_full_20260726T065924Z}"

TEST_EVAL_ROOT="${TEST_EVAL_ROOT:-${EVAL_ROOT}/full_test_e2e_v1}"
FULL_RUN_ID="${FULL_RUN_ID:-full_test_v1}"
DEV_COMPARE_ROOT="${DEV_COMPARE_ROOT:-${EVAL_ROOT}/full_dev_e2e_v1}"
CONTINUITY_REPORT="${CONTINUITY_REPORT:-${REPO_ROOT}/docs/uniss_training_reproduction/simul_uniss_stage7a_grpo_15shard_validation_plan.md}"

R0_TEST_MODEL="${R0_TEST_MODEL:-${E3_V1_MODEL}}"
R1_TEST_MODEL="${R1_TEST_MODEL:-${EXPORT_ROOT}/r1_rebalanced_coverage_best_hf}"
R2_TEST_MODEL="${R2_TEST_MODEL:-${EXPORT_ROOT}/r2_explicit_latency_best_hf}"
R3_TEST_MODEL="${R3_TEST_MODEL:-${EXPORT_ROOT}/r3_bilingual_adaptive_best_hf}"

R0_TEST_GPUS="${R0_TEST_GPUS:-${R0_GPUS}}"
R1_TEST_GPUS="${R1_TEST_GPUS:-${R1_GPUS}}"
R2_TEST_GPUS="${R2_TEST_GPUS:-${R2_GPUS}}"
R3_TEST_GPUS="${R3_TEST_GPUS:-${R3_GPUS}}"

# These values are frozen from full dev and must not be changed after viewing test.
R0_BEST_STEP="${R0_BEST_STEP:-700}"
R1_BEST_STEP="${R1_BEST_STEP:-800}"
R2_BEST_STEP="${R2_BEST_STEP:-300}"
R3_BEST_STEP="${R3_BEST_STEP:-900}"
R0_WRITE_LOGIT_BIAS="${R0_WRITE_LOGIT_BIAS:-0.50}"
R1_WRITE_LOGIT_BIAS="${R1_WRITE_LOGIT_BIAS:-0.00}"
R2_WRITE_LOGIT_BIAS="${R2_WRITE_LOGIT_BIAS:-0.00}"
R3_WRITE_LOGIT_BIAS="${R3_WRITE_LOGIT_BIAS:-0.00}"

BATCH_RECORDS="${BATCH_RECORDS:-1024}"
MAX_WRITE_TOKENS="${MAX_WRITE_TOKENS:-700}"
REPETITION_PENALTY="${REPETITION_PENALTY:-1.1}"
TRAINING_CONTEXT_LIMIT="${TRAINING_CONTEXT_LIMIT:-${MAX_SEQUENCE_LENGTH}}"

LEFT_CONTEXT_TOKENS="${LEFT_CONTEXT_TOKENS:-50}"
HOLDBACK_TOKENS="${HOLDBACK_TOKENS:-5}"
OVERLAP_MS="${OVERLAP_MS:-80}"

# Two metric workers per physical GPU matches the already validated E0-E3 test profile.
METRIC_WORKERS_PER_GPU="${METRIC_WORKERS_PER_GPU:-2}"
LATENCY_RECORDS="${LATENCY_RECORDS:-200}"
SMOKE_RECORDS="${SMOKE_RECORDS:-16}"

