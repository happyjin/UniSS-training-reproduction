PACKED_ROOT="${PACKED_ROOT:-${REPO_ROOT}/data/megatron/${EXPERIMENT_NAME}}"
REPORT_ROOT="${REPORT_ROOT:-${REPO_ROOT}/reports/${EXPERIMENT_NAME}}"
LOG_ROOT="${LOG_ROOT:-${REPO_ROOT}/logs/${EXPERIMENT_NAME}}"
RUN_ROOT="${RUN_ROOT:-${REPO_ROOT}/runs/${EXPERIMENT_NAME}}"
SAVE_ROOT="${SAVE_ROOT:-${REPO_ROOT}/checkpoints/${EXPERIMENT_NAME}}"

SHARD_COUNT=15
CACHE_BATCH_SIZE="${CACHE_BATCH_SIZE:-160}"
TEACHER_REQUEST_BATCH_SIZE="${TEACHER_REQUEST_BATCH_SIZE:-512}"
CONFIDENCE_THRESHOLD="${CONFIDENCE_THRESHOLD:-0.65}"
SEQ_LENGTH="${SEQ_LENGTH:-18000}"
MICRO_BATCH_SIZE="${MICRO_BATCH_SIZE:-2}"
GLOBAL_BATCH_SIZE="${GLOBAL_BATCH_SIZE:-128}"
SEED="${SEED:-20260810}"
TENSORBOARD_PORT="${TENSORBOARD_PORT:-6071}"
